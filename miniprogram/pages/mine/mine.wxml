<!-- pages/mine/mine.wxml -->
<!-- 我的（仿闲鱼风格） -->
<view class="page">

  <!-- 用户信息头部：黄色品牌头 -->
  <view class="uhead">
    <view class="uhead-left">
      <t-avatar class="uhead-avatar" size="large" shape="circle" image="{{avatar}}">{{avatarText}}</t-avatar>
      <view class="uhead-info">
        <view class="uhead-name-row">
          <text class="uhead-name">{{nickname}}</text>
          <t-icon wx:if="{{isVip}}" name="user-vip-filled" size="40rpx" color="#D4AF37" />
          <t-icon name="chevron-right" size="28rpx" color="#1A1A1A" />
        </view>
        <t-tag class="uhead-credit" theme="default" variant="light" size="small">{{creditTag}}</t-tag>
      </view>
    </view>
    <view class="uhead-right">
      <view class="uhead-right-btn" data-what="help" bindtap="onHeaderRightTap">
        <t-icon name="service" size="36rpx" color="#1A1A1A" />
        <text class="uhead-right-text">帮助与客服</text>
      </view>
      <view class="uhead-right-btn" data-what="settings" bindtap="onHeaderRightTap">
        <t-icon name="setting" size="36rpx" color="#1A1A1A" />
        <text class="uhead-right-text">设置</text>
      </view>
    </view>
  </view>

  <!-- 会员横幅（开通/续费） -->
  <view class="vip-banner" bindtap="goVip">
    <view class="vip-banner-left">
      <text class="vip-banner-icon">👑</text>
      <view class="vip-banner-text">
        <view class="vip-banner-title">
          {{ isVip ? ' 会员' : '会员开通' }}
        </view>
        <view class="vip-banner-sub">
          {{ isVip ? ('有效期至 ' + vipExpire) : '专属标识 · 曝光更多 ' }}
        </view>
        <view class="vip-banner-sub">
          {{ isVip ? (' ' ) : '免费发布 · 免费查看 ' }}
        </view>
      </view>
    </view>
    <view class="vip-banner-right">
      <text class="vip-banner-btn">{{ isVip ? '续费' : '立即开通' }}</text>
    </view>
  </view>

  <!-- 4 列统计 -->
  <view class="stats">
      <view class="stat" wx:for="{{statList}}" wx:key="key"
            data-key="{{item.key}}" bindtap="onStatTap">
        <view class="stat-num">{{item.key==='fav' ? favCount : (item.key==='history' ? historyCount : item.num)}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>

  <!-- 我的交易卡片（我发布的 / 付款记录 / 客服） -->
  <view class="card trade">
    <view class="order-row">
      <view class="order" wx:for="{{orderList}}" wx:key="key"
            data-key="{{item.key}}" bindtap="onOrderTap">
        <view class="order-icon">
          <t-icon name="upload" wx:if="{{item.key==='sell'}}" size="48rpx" color="#FF7A45" />
          <t-icon name="shop" wx:elif="{{item.key==='sold'}}" size="48rpx" color="#36CFC9" />
          <t-icon name="service" wx:elif="{{item.key==='service'}}" size="48rpx" color="#FA8C16" />
          <t-icon name="cart" wx:else size="48rpx" color="#FA8C16" />
        </view>
        <text class="order-label">{{item.label}}</text>
        <text class="order-count">{{item.count}}</text>
      </view>
    </view>
  </view>

  <!-- 公告 -->
  <view class="notice" bindtap="onNoticeTap">
    <text class="notice-tag">公告</text>
    <text class="notice-text">{{notice}}</text>
    <t-icon name="chevron-right" size="24rpx" color="#999999" />
  </view>

  <!-- 关于 / 意见反馈 / 清除缓存 / 我的认证 -->
  <t-cell-group theme="card" title="通用">
    <t-cell title="我的认证" description="店主 / 师傅 / 商家 身份认证" left-icon="verified" arrow hover bind:click="onIdentityTap" />
    <t-cell title="意见反馈" description="功能建议 / 使用问题 / 举报投诉" left-icon="chat" arrow hover bind:click="onFeedbackTap" />
    <t-cell title="清除浏览缓存" description="清除本地浏览历史缓存" left-icon="delete" arrow hover bind:click="onClearCacheTap" />
    <t-cell title="关于我们" left-icon="info-circle" arrow hover bind:click="onAboutTap" />
  </t-cell-group>

  <!-- 协议与政策 -->
  <t-cell-group theme="card" title="协议与政策">
    <t-cell title="隐私政策" left-icon="lock-on" arrow hover bind:click="onPrivacyTap" />
    <t-cell title="用户协议" left-icon="file" arrow hover bind:click="onTermsTap" />
  </t-cell-group>

  <!-- 底部真实 TabBar（同 demo；mine 独立页，点击用 reLaunch 切换） -->
  <t-tab-bar
    class="mine-tabbar"
    value="{{activeBar}}"
    bindchange="onTabBar"
    theme="normal"
    fixed="{{true}}"
    placeholder="{{true}}"
    split="{{false}}"
  >
    <t-tab-bar-item wx:for="{{tabbar}}" wx:key="id" value="{{item.id}}"
      icon="{{item.id === 'me' ? (isVip ? 'user-vip-filled' : 'user') : item.icon}}"
      badge-props="{{ item.id === 'message' ? { count: unread } : null }}">{{item.label}}</t-tab-bar-item>
  </t-tab-bar>

  <!-- 清除缓存确认 -->
  <t-dialog
    visible="{{clearDialogVisible}}"
    title="清除缓存"
    content="将清除本地浏览历史缓存（不会删除你发布的信息），确定继续？"
    confirm-btn="{{ { content: '确定清除', theme: 'danger' } }}"
    cancel-btn="取消"
    bind:confirm="onClearConfirm"
    bind:cancel="onClearDialogClose"
    bind:close="onClearDialogClose"
  />

  <!-- 关于 -->
  <t-dialog
    visible="{{aboutDialogVisible}}"
    title="关于包子一哥"
    content="包子行业信息平台 · 招聘求职 / 店铺转让 / 二手设备 / 顺风车 / 其他，免费发布、就近对接。"
    confirm-btn="知道了"
    bind:confirm="onAboutDialogClose"
    bind:close="onAboutDialogClose"
  />

  <!-- 发布类型选择弹层（同 demo 首页，点底部"发布"触发） -->
  <t-popup
    visible="{{publishSheetVisible}}"
    placement="bottom"
    bind:visible-change="onPublishSheetClose"
  >
    <view class="pub-sheet">
      <view class="pub-sheet-title">选择发布类型</view>
      <t-grid class="pub-grid" column="{{4}}" hover>
        <t-grid-item
          wx:for="{{publishTypes}}" wx:key="id"
          data-item="{{item}}" bind:click="onPickPublishType"
        >
          <view class="pub-icon" style="background: {{item.light}};">
            <t-icon name="{{item.icon}}" size="44rpx" color="{{item.color}}" />
          </view>
          <view class="pub-name">{{item.name}}</view>
        </t-grid-item>
      </t-grid>
    </view>
  </t-popup>

</view>