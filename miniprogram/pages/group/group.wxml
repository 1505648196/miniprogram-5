<!-- pages/group/group.wxml -->
<!-- 包友群：群列表，点卡片弹二维码加群 -->
<view class="page">
  <view class="head-banner">
    <view class="head-title">包友群</view>
    <view class="head-sub">同行交流 · 资源共享</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="skeleton-wrap">
    <t-skeleton theme="paragraph" animation="gradient" row-col="{{skeletonRows}}" />
  </view>

  <!-- 空态 -->
  <view wx:elif="{{!list.length}}" class="empty">
    <t-icon name="usergroup" size="120rpx" color="#CCCCCC" />
    <text>暂无包友群</text>
  </view>

  <!-- 群列表 -->
  <view wx:else class="list">
    <view class="group-card" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="onGroupTap">
      <image class="group-cover" src="{{item.cover || '/static/home-default.png'}}" mode="aspectFill" />
      <view class="group-info">
        <view class="group-row1">
          <text class="group-name">{{item.name}}</text>
          <t-tag size="small" variant="light">{{item.city}}</t-tag>
        </view>
        <view class="group-intro" wx:if="{{item.intro}}">{{item.intro}}</view>
        <view class="group-meta" wx:if="{{item.member_count}}">
          <t-icon name="usergroup" size="24rpx" color="#999999" />
          <text>{{item.member_count}} 人</text>
        </view>
      </view>
      <t-icon name="chevron-right" size="32rpx" color="#CCCCCC" />
    </view>
  </view>

  <!-- 加群二维码弹窗 -->
  <t-popup visible="{{qrVisible}}" placement="center" bind:visible-change="onQrVisibleChange">
    <view class="qr-pop" wx:if="{{currentGroup}}">
      <view class="qr-title">{{currentGroup.name}}</view>
      <image
        wx:if="{{currentGroup.qr_code}}"
        class="qr-img"
        src="{{currentGroup.qr_code}}"
        mode="aspectFit"
        show-menu-by-longpress="{{true}}"
      />
      <view wx:else class="qr-placeholder">暂未提供群二维码</view>
      <view class="qr-tip">长按识别二维码，或保存后扫码进群</view>
      <t-button theme="primary" size="small" block bindtap="onCloseQr">关闭</t-button>
    </view>
  </t-popup>
</view>
