/* pages/group/group.wxss */
.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx 24rpx 60rpx;
}

.head-banner {
  background: linear-gradient(135deg, #2A6DFF 0%, #4D8DFF 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.head-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #FFFFFF;
}

.head-sub {
  font-size: 24rpx;
  color: #FFE60A;
  margin-top: 8rpx;
}

.skeleton-wrap {
  padding: 8rpx 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 120rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.group-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
}

.group-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #F0F0F0;
  flex-shrink: 0;
}

.group-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.group-row1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

.group-intro {
  font-size: 24rpx;
  color: #666666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.group-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #999999;
}

/* 二维码弹窗 */
.qr-pop {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 560rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.qr-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.qr-img {
  width: 400rpx;
  height: 400rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
}

.qr-placeholder {
  width: 400rpx;
  height: 400rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  font-size: 26rpx;
}

.qr-tip {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}
