/* pages/demo/demo.wxss */
/* 包子行业信息平台 · 首页 —— TDesign CSS 变量覆盖，不改组件源码 */

.page {
  min-height: 100vh;
  position: relative;
  padding-bottom: 180rpx;
}

/* ============ 黄色 Header ============ */
.header {
  height: 96rpx;
  background: #FFE60A;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  gap: 20rpx;
}

.header-logo {
  font-size: 36rpx;
  font-weight: 800;
  color: #1A1A1A;
  letter-spacing: 2rpx;
  flex-shrink: 0;
  width: 144rpx;
  white-space: nowrap;
}

.hdr-search {
  flex: 1;
  min-width: 0;
  /* 黄色胶囊搜索框：黄底 + 黑字黑图标 + 黑色边框（从 Header 黄色中区分出来） */
  --td-search-bg-color: #FFE60A;
  --td-search-height: 72rpx;
  --td-search-padding: 12rpx 28rpx;
  --td-search-font: 28rpx;
  --td-search-icon-size: 36rpx;
  --td-search-placeholder-color: #1A1A1A;
  --td-search-text-color: #1A1A1A;
  --td-search-icon-color: #1A1A1A;
  --td-search-clear-icon-color: #1A1A1A;
  --td-search-action-color: #1A1A1A;
  border: 3rpx solid #1A1A1A;
  border-radius: 36rpx;
  overflow: hidden;
}

.hdr-publish {
  flex-shrink: 0;
  --td-button-bg-color: #1A1A1A;
  --td-button-border-color: #1A1A1A;
  --td-button-font: 24rpx;
}

/* ============ 顶部选项卡(t-tabs line) ============ */
.top-tabs {
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
  --td-tab-nav-bg-color: #ffffff;
  --td-tab-item-height: 88rpx;
  --td-tab-item-color: #666666;
  --td-tab-item-active-color: #1A1A1A;
  --td-tab-item-active-font: 700;
  --td-tab-track-color: #1A1A1A;
  --td-tab-track-width: 48rpx;
  --td-tab-track-thickness: 6rpx;
  --td-tab-font: 28rpx;
}

/* 吸顶态阴影：tabs 为 apply-shared，页面样式可作用到内部 __wrapper */
.top-tabs .t-tabs__wrapper {
  transition: box-shadow 0.18s ease;
}

.top-tabs.is-sticky .t-tabs__wrapper {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* ============ 主内容 ============ */
.content {
  background: #FFFFFF;
  padding: 0 16rpx;
  border-radius: 0 0 24rpx 24rpx;
}

/* ============ 帖子流容器（模块 5 吸顶后独立全宽，帖子流在白底区内） ============ */
.feed {
  /* background: #FFFFFF; */
  padding: 0 16rpx;
}

/* ============ 金刚位 8 宫格 ============ */
.kk {
  padding: 0 0 8rpx;
  --td-grid-item-padding: 20rpx 0;
}

.kk-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.06);
}

/* 金刚位图片图标：等比缩放居中填满格子，圆角裁剪 */
.kk-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  display: block;
}

.kk-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #1A1A1A;
}

/* ============ Banner ============ */
.banners {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0 0;
}

.banner {
  flex: 1;
  height: 108rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.banner-ai {
background: #eae5e55e;
}

.banner-pub {
 background: #eae5e55e;
}

.banner-emoji {
  font-size: 57rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* 自定义图片图标：emoji 容器大小内 aspectFit 适配 */
.banner-emoji-img {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.banner-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.banner-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF7A45;
}

.banner-sub {
  font-size: 22rpx;
  color:#FF7A45
}

/* ============ 模块 4b 热门推荐（白底卡片组容器，按设计稿） ============ */
/* 卡片组容器：白底圆角大容器，flex 纵向排区头+卡片行 */
.card-group {
  background: #FFFFFF;
  border-radius: 46rpx;
  padding: 31rpx;
  display: flex;
  flex-direction: column;
  gap: 31rpx;
  box-sizing: border-box;
  width: 100%;
}

/* 区头：标题左 + 查看全部右 */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.section-title {
  font-size: 33rpx;
  font-weight: 700;
  color: #2B1B12;
  line-height: 1;
}
.more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.more-text {
  font-size: 23rpx;
  font-weight: 500;
  color: #A09386;
  line-height: 1;
}

/* 卡片行：左大 + 右上下两小，flex 横排，固定高 400rpx */
.card-row {
  display: flex;
  gap: 23rpx;
  height: 400rpx;
}

/* 左大卡：头条卡（大），严格按标准实例 headline-card 组件
   （设计稿 208×208px → 400×400rpx，基准 390px→750rpx 系数 1.923） */
.headline-card {
  position: relative;
  box-sizing: border-box;
  width: 400rpx;
  height: 400rpx;
  flex: 0 0 400rpx;
  padding: 31rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
  border-radius: 38rpx;
  overflow: hidden;
  background: linear-gradient(90deg, #FFF5E0 0%, #FFCF87 100%);
  box-shadow: 0 15rpx 38rpx -12rpx rgba(217, 133, 51, 0.3);
}

/* —— 今日头条 标签（t-tag 覆盖） —— */
.badge-tag {
  --td-tag-danger-color: #E3380F;
  --td-tag-square-border-radius: 12rpx;
  --td-tag-small-font: 19rpx;
  align-self: flex-start;
  padding: 8rpx;
  margin: 0;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1;
  color: #FFFFFF;
  background-color: #E3380F;
  border-radius: 12rpx;
}

/* —— 右上角包子插画：外层 view 绝对定位（left 104px(200rpx) / top 6px(12rpx)），
     t-image 内部填满 wrap（避免 t-image wrapper 不继承 absolute 导致插画被挤下） —— */
.headline-illust-wrap {
  position: absolute;
  left: 200rpx;
  top: 12rpx;
  width: 185rpx;
  height: 185rpx;
  border-radius: 31rpx;
  overflow: hidden;
  z-index: 1;
}
.headline-illust {
  width: 100% !important;
  height: 100% !important;
  display: block;
}

/* —— 标题组：推到底部 —— */
.title-group {
  margin-top: auto;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.title-line {
  width: 100%;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 42rpx;
  color: #3A2412;
}
.title-line2 {
  width: 100%;
  height: 42rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
}
.title-strong {
  font-size: 31rpx;
  font-weight: 700;
  line-height: 42rpx;
  color: #3A2412;
}
.title-price {
  font-size: 31rpx;
  font-weight: 900;
  line-height: 42rpx;
  color: #E3380F;
}

/* —— 查看详情 —— */
.cta {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
}
.cta-text {
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
  color: #8A5A2B;
}

/* 右上下两小卡容器：纵向 flex 均分，与左大卡同高 */
.side-column {
  flex: 0 0 265rpx;
  width: 265rpx;
  height: 400rpx;
  display: flex;
  flex-direction: column;
  gap: 23rpx;
}
.mini-card {
  position: relative;
  flex: 1;
  min-width: 0;
  border-radius: 35rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start; /* 文字整体靠左 */
  gap: 6rpx;
  overflow: hidden;
}
/* 第一行：图标 + 标题水平一排 */
.mini-head {
  display: flex;
  align-items: center;
  gap: 6rpx;
  /* 给右侧插画预留空间，避免被压住 */
  padding-right: 80rpx;
  min-height: 40rpx;
}
/* 右下小卡插画：绝对定位右侧，VIP 奖章/包子群 不同尺寸 */
.mini-illust {
  position: absolute;
  z-index: 1;
  pointer-events: none; /* 不拦截点击 */
  display: block;
}
/* VIP 奖章：靠右上，参考图比例（适中） */
.mini-illust.vip-medal {
  right: -1rpx;
  top: 6rpx;
  width: 125rpx;
  height: 140rpx;
}
/* 包子群：靠右下，宽度更大（5 个包子横向铺开） */
.mini-illust.baozi-group {
  right: -20rpx;
  /* bottom: 24rpx; */
  width: 150rpx;
  height: 120rpx;
}
/* 右下小标签+箭头：贴右下角 */
.mini-bottom {
  margin-top: auto; /* 推到底部 */
  display: flex;
  align-items: center;
  gap: 4rpx;
  align-self: flex-end; /* 整组靠右 */
}
.mini-bottom-text {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}
.mini-card.vip .mini-bottom-text {
  color: #4E7A68;
}
.mini-card.group .mini-bottom-text {
  color: #A58153;
}
/* VIP 卡：浅绿背景 */
.mini-card.vip {
  background: #E7F5EE;
}
.mini-card.vip .mini-title {
  color: #14513B;
}
.mini-card.vip .mini-sub {
  color: #4E7A68;
}
/* 包友群卡：浅黄背景 */
.mini-card.group {
  background: #FFF1DA;
}
.mini-card.group .mini-title {
  color: #7A4A22;
}
.mini-card.group .mini-sub {
  color: #A58153;
}
.mini-title {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 42rpx;
}
.mini-sub {
  font-size: 23rpx;
  font-weight: 400;
  line-height: 32rpx;
}

/* ============ 筛选 Tab ============ */
.goods-tabs {
  border-bottom: 1rpx solid #F0F0F0;
  --td-tab-nav-bg-color: #ffffff;
  --td-tab-item-height: 80rpx;
  --td-tab-item-tag-height: 56rpx;
  --td-tab-item-tag-bg: #F5F5F5;
  --td-tab-item-tag-active-bg: #1A1A1A;
  --td-tab-item-color: #666666;
  --td-tab-item-active-color: #FFFFFF;
  --td-tab-font: 26rpx;
  --td-tab-item-active-font: 600;
}

.tabs-hide-content {
  display: none;
}

/* ============ 帖子双列 ============ */
.goods {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0 32rpx;
}

.goods-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.goods-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  /* 定位上下文：无图时 goods-card-badge 绝对定位锚定在卡片左上角 */
  position: relative;
}

/* 置顶卡片：闲鱼金色边框高亮 */
.goods-card-top {
  border: 2rpx solid #FFC300;
  box-shadow: 0 2rpx 12rpx rgba(255, 195, 0, 0.35);
}

/* 标签条（默认：绝对定位到图片左上角） */
.goods-badges {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 无图时：标签条改为卡片顶部的流式一行 */
.goods-badges-top {
  position: static;
  padding: 12rpx 16rpx 0;
}

/* 标签条内单个标签 */
.goods-badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #FFFFFF;
  border-radius: 999rpx;
  white-space: nowrap;
}

/* 「置顶」图片徽章：高度固定、宽度按原图比例自适应，与旁边类型标签垂直对齐 */
.goods-badge-top-img {
  display: block;
  height: 50rpx;
  width: auto;
  flex-shrink: 0;
}

/* 无图时，地区·时间行内的业务类型高亮小标签（品牌色底 + 白字圆角） */
.goods-meta-type {
  flex-shrink: 0;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  max-width: 40%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-img {
  position: relative;
  width: 100%;
  max-height: 330rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-emoji {
  font-size: 84rpx;
  line-height: 1;
}

/* 帖子图片：宽度撑满、高度按原比例自适应（widthFix）；超过容器 max-height 时上下对称裁剪，保留中间 */
.goods-pic {
  width: 100%;
  display: block;
  flex-shrink: 0;
}

.goods-type {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.4;
  max-width: 70%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-title {
  font-size: 26rpx;
  color: #1A1A1A;
  line-height: 1.4;
  padding: 16rpx 16rpx 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 12rpx 16rpx 0;
}

.goods-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999999;
  padding: 8rpx 16rpx 0;
  white-space: nowrap;
  overflow: hidden;
}

/* 发布用户昵称/称呼（有 username 才展示）；昵称 + 信用标签横排 */
.goods-user {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #666666;
  padding: 8rpx 16rpx 0;
  white-space: nowrap;
  overflow: hidden;
}

/* 信用评分标签（有 credit 才显示；颜色/底色由 creditMeta 内联控制） */
.goods-credit {
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 1;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
}

.goods-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 16rpx 16rpx;
  gap: 8rpx;
}

.goods-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF7A45;
  line-height: 1.2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-arrow {
  font-size: 20rpx;
  color: #999999;
  flex-shrink: 0;
}

.goods-loading,
.goods-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}

/* 列表加载骨架屏：双列卡片骨架，与真实帖子流同款留白与间距 */
.feed-skeleton {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0 32rpx;
}

.feed-skeleton-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 单张骨架卡片：白底圆角 + 阴影，内部骨架项纵向排布 */
.feed-skeleton-col .t-skeleton {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  padding: 16rpx;
}

/* 骨架卡片内每行之间的间距：覆盖 t-skeleton 默认 32rpx，收紧到接近真实卡片 */
.feed-skeleton-col .t-skeleton .t-skeleton__row {
  margin-bottom: 16rpx;
}

/* 触底加载更多 / 没有更多 */
.feed-footer {
  padding: 16rpx 0 40rpx;
  display: flex;
  justify-content: center;
}

.feed-end-text {
  font-size: 22rpx;
  color: #cccccc;
}

/* ============ 底部 TabBar ============ */
.demo-tabbar {
  --td-tab-bar-height: 96rpx;
  --td-tab-bar-color: #666666;
  --td-tab-bar-active-color: #FF7A45;
  --td-tab-bar-font: 20rpx;
}

/* ============ 发布类型选择弹层（TDesign t-popup + t-grid） ============ */
.pub-sheet {
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 16rpx calc(32rpx + env(safe-area-inset-bottom));
}

.pub-sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  text-align: center;
  margin-bottom: 24rpx;
}

.pub-grid {
  --td-grid-item-padding: 20rpx 0;
}

.pub-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.06);
}

.pub-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #1A1A1A;
}

/* ============ 手机号授权弹层 ============ */
.auth-sheet {
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.auth-emoji {
  font-size: 72rpx;
  line-height: 1;
}

.auth-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.auth-desc {
  margin: 20rpx auto 40rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* 微信原生授权按钮：重置默认样式 + 用 TDesign 视觉 */
.auth-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
  border: none;
  text-align: center;
}

.auth-btn::after {
  border: none;
}

.auth-cancel {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #999999;
  padding: 8rpx 0;
}

/* ============ 广告轮播位（ads 为空时整块不渲染） ============ */
.ads {
  padding: 16rpx 0 0;
}

.ads-swiper {
  border-radius: 20rpx;
  overflow: hidden;
}

/* ============ Banner 运营卡位 ============ */
.banners {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0 0;
}

.banner {
  flex: 1;
  min-width: 0;
  height: 108rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.banner-emoji {
  font-size: 48rpx;
  flex-shrink: 0;
  line-height: 1;
}



.banner-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.banner-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.banner-sub {
  font-size: 22rpx;
  color: #666666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ============ 服务保障数字卡位 ============ */
.stats {
  display: flex;
  padding: 24rpx 0 8rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 0;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #FF7A45;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

/* ============ 包友圈商家（横向滚动卡片） ============ */
.partners {
  padding: 24rpx 0 8rpx;
}

.partners-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 16rpx;
}

.partners-title-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.partners-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.partners-all {
  display: flex;
  align-items: center;
  gap: 2rpx;
  font-size: 24rpx;
  color: #999999;
}

.partners-scroll {
  /* scroll-view 横向：white-space:nowrap 让子项横向排列，可手指拖动 */
  white-space: nowrap;
}

/* 包友圈商家骨架卡：与真实商家卡同宽(140rpx)，图片块+名称占位 */
.partners-skeleton {
  display: inline-block;
  width: 140rpx;
  margin-right: 16rpx;
  vertical-align: top;
  white-space: normal;
}

.partners-skeleton .t-skeleton {
  width: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.partners-card {
  display: inline-block;
  width: 140rpx;
  margin-right: 16rpx;
  vertical-align: top;
  white-space: normal;
}

.partners-img {
  display: block;
  width: 140rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
}

.partners-name {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #1A1A1A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 末尾"更多商家"卡：和普通卡同宽，但背景用品牌橙 + 白字 */
.partners-card-more {
  width: 140rpx;
  height: 152rpx; /* 120 图 + 4 间距 + 22 字号名称 ≈ 146，取 152 */
  background: #FF7A45;
  border-radius: 12rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.partners-more-text {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

/* ============ 金色悬浮按钮（圆形，右下角，分享按钮上方） ============ */
.gold-fab {
  position: fixed;
  right: 32rpx;
  bottom: 340rpx; /* 位于分享按钮(220rpx + 100rpx 高 + 20rpx 间距)上方 */
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFD700 0%, #FFC300 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 195, 0, 0.45);
  z-index: 999;
  padding: 0;
  margin: 0;
  border: 2rpx solid #E6AC00;
  line-height: 1;
}

.gold-fab::after {
  border: none;
}

/* ============ 悬浮分享按钮（圆形，右下角，图标 + 文字） ============ */
.share-fab {
  position: fixed;
  right: 32rpx;
  bottom: 220rpx; /* 避开底部 tabbar（约 120rpx）+ 留白 */
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF7A45 0%, #FF9E6B 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 69, 0.4);
  z-index: 999;
  padding: 0;
  margin: 0;
  border: none;
  line-height: 1;
}

.share-fab::after {
  border: none;
}

.share-fab-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1;
}

.share-fab-hover {
  transform: scale(0.92);
  opacity: 0.9;
}

/* ============ 全局弹窗广告（居中） ============ */
.ad-popup-inner {
  position: relative;
  width: 600rpx;
  max-width: 80vw;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.ad-popup-img {
  width: 100%;
  display: block;
}

/* 无图文字卡兜底 */
.ad-popup-text {
  padding: 80rpx 48rpx;
  text-align: center;
}

.ad-popup-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}

.ad-popup-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #8c8c8c;
  line-height: 1.4;
}

/* 关闭按钮：图片右上角圆形半透明 */
.ad-popup-close {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  z-index: 2;
}

