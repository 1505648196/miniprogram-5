/* pages/merchant-apply/merchant-apply.wxss */
.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 60rpx;
}

/* ============ 顶部 banner（蓝底） ============ */
.hero {
  position: relative;
  background: linear-gradient(135deg, #2A6DFF 0%, #4D8DFF 100%);
  padding: 24rpx 32rpx 16rpx;
  color: #FFFFFF;
}

.hero-badge {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  background: #FF7A45;
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.hero-title {
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  margin-top: 16rpx;
}

.hero-sub {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFE60A;
  margin-top: 8rpx;
}

.hero-sub2 {
  font-size: 26rpx;
  color: #FFE60A;
  margin-top: 2rpx;
}

.hero-search {
  margin-top: 20rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  gap: 12rpx;
  color: #1A1A1A;
}

.hero-search-tag {
  font-size: 24rpx;
  color: #999999;
  border-right: 2rpx solid #ECECEC;
  padding-right: 12rpx;
}

.hero-search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
}

.hero-gg {
  display: flex;
  margin-top: 16rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 16rpx;
  padding: 12rpx 0;
}

.hero-gg-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.hero-gg-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.hero-gg-name {
  font-size: 22rpx;
  color: #FFFFFF;
}

/* 3 宫格选中态：白底高亮 */
.hero-gg-item.is-on {
  background: rgba(255, 255, 255, 0.3);
  border-radius: 12rpx;
}

.hero-gg-item.is-on .hero-gg-name {
  color: #FFE60A;
  font-weight: 700;
}

/* ============ 立即入驻按钮（列表/表单两模式都显示） ============ */
.apply-cta-wrap {
  margin: 24rpx 24rpx 0;
}

.apply-cta {
  --td-button-primary-bg-color: #FF7A45;
  --td-button-primary-border-color: #FF7A45;
  --td-button-primary-color: #FFFFFF;
  --td-button-primary-active-bg-color: #E5642F;
  --td-button-primary-active-border-color: #E5642F;
  font-weight: 700;
}

/* ============ 商家列表 ============ */
.list {
  margin: 16rpx 24rpx 0;
}

.list-head {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin: 16rpx 0;
}

/* 3 Tab：推荐 / 新入 / 附近 */
.merchant-tabs {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
  padding-bottom: 12rpx;
}

.merchant-tab {
  font-size: 28rpx;
  color: #666666;
  padding: 4rpx 0;
  position: relative;
}

.merchant-tab.is-on {
  color: #1A1A1A;
  font-weight: 700;
}

.merchant-tab.is-on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -13rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #FF7A45;
  border-radius: 3rpx;
}

.list-skeleton {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-card {
  display: flex;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  align-items: center;
  margin-bottom: 16rpx;
}

.list-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  flex-shrink: 0;
}

.list-thumb-skel {
  background: #EFEFEF;
}

.list-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.list-row1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.list-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

.list-name-skel {
  height: 32rpx;
  width: 60%;
  background: #EFEFEF;
  border-radius: 6rpx;
}

.list-cat {
  font-size: 22rpx;
  color: #FF7A45;
  background: #FFF1E8;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.list-row2 {
  font-size: 24rpx;
  color: #999999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.list-meta-skel {
  height: 24rpx;
  width: 80%;
  background: #EFEFEF;
  border-radius: 6rpx;
}

.list-empty {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* ============ 表单（弹窗内容） ============ */
.form-popup {
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx 40rpx;
  max-height: 80vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.form-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin: 0 0 16rpx;
  text-align: center;
}

.form-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin: 16rpx 0;
}

.cell-input {
  font-size: 28rpx;
  color: #1A1A1A;
  text-align: right;
}

.cell-pick {
  font-size: 28rpx;
  color: #1A1A1A;
  text-align: right;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.cell-placeholder {
  color: #BBBBBB;
}

.cell-loc-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 18rpx;
  color: #4D8DFF;
  gap: 2rpx;
}

.form-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 24rpx;
  margin-top: 16rpx;
}

.form-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.form-section-tip {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
}

.form-section-tip-line {
  display: block;
  margin: -8rpx 0 16rpx;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

/* 图片上传 */
.upload-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.upload-row-wrap {
  flex-wrap: wrap;
}

.upload-add {
  width: 200rpx;
  height: 200rpx;
  background: #FAFAFA;
  border: 2rpx dashed #DDDDDD;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
}

.upload-pic {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #F0F0F0;
}

.upload-avatar {
  width: 200rpx;
  height: 200rpx;
}

.upload-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #FF4D4F;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 28rpx;
}

/* 套餐卡片 */
.plan-card {
  margin-top: 16rpx;
  background: linear-gradient(135deg, #FFE7B0 0%, #FFD179 100%);
  border-radius: 16rpx;
  padding: 24rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
}

.plan-card-main {
  display: flex;
  flex-direction: column;
}

.plan-card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.plan-card-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #FF4D4F;
  line-height: 1.2;
}

.plan-card-yuan {
  font-size: 24rpx;
}

.plan-card-period {
  font-size: 22rpx;
  color: #666666;
}

.plan-card-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #FF7A45;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
}

.form-tip {
  font-size: 24rpx;
  color: #4D8DFF;
  margin-top: 16rpx;
  text-align: center;
}

/* 同意条款 */
.agree {
  margin: 24rpx 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.agree-box {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #DDDDDD;
  border-radius: 6rpx;
  background: #FFFFFF;
  font-size: 22rpx;
  color: #FFFFFF;
  text-align: center;
  line-height: 28rpx;
  box-sizing: border-box;
}

.agree-box.is-on {
  background: #FF7A45;
  border-color: #FF7A45;
}

.agree-text {
  font-size: 26rpx;
  color: #1A1A1A;
}

.submit-btn-wrap {
  margin-top: 16rpx;
}

/* ============ 分类选择弹层 ============ */
.picker {
  background: #FFFFFF;
  padding: 24rpx 24rpx 40rpx;
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 16rpx;
}

.picker-cancel, .picker-confirm {
  font-size: 28rpx;
  color: #4D8DFF;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.picker-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}

.picker-grid-item {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1A1A1A;
  background: #FAFAFA;
  border-radius: 12rpx;
}

.picker-grid-item.is-on {
  background: #FFE60A;
  color: #1A1A1A;
  font-weight: 700;
}
