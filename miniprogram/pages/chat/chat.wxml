<!-- pages/chat/chat.wxml 行业复盘 AI 问答界面（腾讯元宝风格） -->
<view class="page">

  <!-- 消息区 -->
  <scroll-view
    class="msg-scroll"
    scroll-y
    scroll-with-animation
    enable-flex
    scroll-into-view="{{scrollIntoView}}"
  >
    <view class="msg-list">
      <!-- 空状态：建议问题 -->
      <block wx:if="{{messages.length === 0}}">
        <view class="empty">
          <view class="empty-logo">📈</view>
          <view class="empty-title">包子行业 AI 顾问</view>
          <view class="empty-sub">招工 · 求职 · 转让 · 求店，想聊点什么？</view>
          <view class="empty-suggestions">
            <view
              class="suggest-btn"
              wx:for="{{suggestions}}"
              wx:key="*this"
              data-text="{{item}}"
              bindtap="onSuggestTap"
            >{{item}}</view>
          </view>
        </view>
      </block>

      <!-- 对话消息 -->
      <block wx:else>
        <block wx:for="{{messages}}" wx:key="id" wx:for-item="item">
          <!-- AI 消息：头像在左，气泡紧跟其后 -->
          <view class="msg-row" wx:if="{{item.role === 'ai'}}" id="{{item.id}}">
            <view class="avatar avatar-ai">AI</view>
            <view class="bubble {{item.msgType === 'list' ? 'bubble-list' : ''}}">
              <!-- 列表类：summary + 卡片（与招工列表同款） -->
              <block wx:if="{{item.msgType === 'list'}}">
                <view class="list-head" wx:if="{{item.content}}">{{item.content}}</view>
                <view class="post-card" wx:for="{{item.cards}}" wx:for-item="card" wx:key="_id">
                  <view class="post-top">
                    <text class="post-role">{{card.role || '信息'}}</text>
                    <text class="post-location">{{card.locationText}}</text>
                    <text class="post-time">{{card.timeText}}</text>
                  </view>
                  <view class="post-salary" wx:if="{{card.salaryText}}">💼 {{card.salaryText}}</view>
                  <view class="post-line" wx:if="{{card.address}}">📍 {{card.address}}</view>
                  <view class="post-line" wx:if="{{card.contactText}}">👤 {{card.contactText}}</view>
                  <view class="post-desc" wx:if="{{card.raw_text}}">{{card.raw_text}}</view>
                  <view class="post-tags" wx:if="{{card.tagItems && card.tagItems.length}}">
                    <text
                      class="post-tag {{tagItem.cls}}"
                      wx:for="{{card.tagItems}}"
                      wx:for-item="tagItem"
                      wx:key="name"
                    >{{tagItem.name}}</text>
                  </view>
                </view>
              </block>
              <!-- 普通文本 -->
              <block wx:else>
                {{item.content}}<text class="cursor" wx:if="{{item.streaming}}">▍</text>
              </block>
            </view>
          </view>

          <!-- User 消息：气泡在左、头像在右，气泡撑到内容宽度 -->
          <view class="msg-row msg-row-user" wx:else id="{{item.id}}">
            <view class="bubble {{item.msgType === 'list' ? 'bubble-list' : ''}}">
              <block wx:if="{{item.msgType === 'list'}}">
                <view class="list-head" wx:if="{{item.content}}">{{item.content}}</view>
                <view class="post-card" wx:for="{{item.cards}}" wx:for-item="card" wx:key="_id">
                  <view class="post-top">
                    <text class="post-role">{{card.role || '信息'}}</text>
                    <text class="post-location">{{card.locationText}}</text>
                    <text class="post-time">{{card.timeText}}</text>
                  </view>
                  <view class="post-salary" wx:if="{{card.salaryText}}">💼 {{card.salaryText}}</view>
                  <view class="post-line" wx:if="{{card.address}}">📍 {{card.address}}</view>
                  <view class="post-line" wx:if="{{card.contactText}}">👤 {{card.contactText}}</view>
                  <view class="post-desc" wx:if="{{card.raw_text}}">{{card.raw_text}}</view>
                  <view class="post-tags" wx:if="{{card.tagItems && card.tagItems.length}}">
                    <text
                      class="post-tag {{tagItem.cls}}"
                      wx:for="{{card.tagItems}}"
                      wx:for-item="tagItem"
                      wx:key="name"
                    >{{tagItem.name}}</text>
                  </view>
                </view>
              </block>
              <block wx:else>
                {{item.content}}
              </block>
            </view>
            <!-- <view class="avatar avatar-user">我</view> -->
          </view>
        </block>
      </block>
    </view>
  </scroll-view>

  <!-- 底部固定输入条 -->
  <view class="footer">
  <view class="input-bar">
    <view class="clear-btn" bindtap="clearChat" hover-class="clear-btn-hover">🗑</view>
    <input
        class="input"
        value="{{inputValue}}"
        placeholder="问问招工、求职、转让、求店"
        placeholder-class="input-placeholder"
        confirm-type="send"
        disabled="{{loading}}"
        bindinput="onInput"
        bindconfirm="onSend"
      />
      <view class="send-btn {{loading ? 'send-btn-disabled' : ''}}" bindtap="onSend">发送</view>
    </view>
    <view class="safe-area"></view>
  </view>

</view>
