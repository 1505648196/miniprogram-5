/* pages/chat/chat.wxss 行业复盘 AI 问答界面样式（腾讯元宝风格：深色无气泡） */

page {
  /* background: #1a1a1a; */
  height: 100%;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  /* background: #1a1a1a; */
  color: #fff;
}

/* ============ 消息滚动区 ============ */
.msg-scroll {
  flex: 1;
  height: 0; /* 配合 flex-grow 让 scroll-view 获得确定高度 */
  min-height: 0;
}

.msg-list {
  padding: 32rpx 32rpx 24rpx;
  box-sizing: border-box;
}

/* ---------- 空状态 ---------- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07c160, #10aeff);
  color: #fff;
  font-size: 56rpx;
  line-height: 120rpx;
  text-align: center;
}

.empty-title {
  margin-top: 32rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8a8e;
}

.empty-suggestions {
  margin-top: 48rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.suggest-btn {
  width: 80%;
  margin-bottom: 24rpx;
  padding: 24rpx 32rpx;
  background: #2a2a2a;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #fff;
  text-align: center;
}

.suggest-btn:active {
  opacity: 0.7;
}

/* ---------- 消息行（float 方案：气泡按内容自动收缩，绝对不会再撑满） ---------- */
.msg-row {
  margin-bottom: 24rpx;
  overflow: hidden; /* 清浮动 */
  position: relative;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
  text-align: center;
  line-height: 64rpx;
  margin-top: 4rpx;
}

/* AI 头像：左浮 */
.msg-row .avatar-ai {
  float: left;
  margin-right: 16rpx;
  background: linear-gradient(135deg, #10aeff, #6a5af9);
}
/* 用户头像：右浮 */
.msg-row .avatar-user {
  float: right;
  margin-left: 16rpx;
  background: #3a3a3a;
}

/* ===== AI 消息气泡：默认无背景，白字直接铺 ===== */
.bubble {
  /* display: block;
  word-break: break-all;
  white-space: pre-wrap;
  background: transparent;
  color: #e8e8e8;
  padding: 6rpx 0;
  font-size: 30rpx;
  line-height: 1.55;
  text-align: left; */
}
/* AI 行：bubble 跟在浮动头像后，避开左浮头像 */
.msg-row .avatar-ai + .bubble {
  margin-left: 80rpx; /* 64 头像 + 16 间距 */
}

/* ===== 用户消息气泡：浅绿圆角，紧贴文字，文字居中 ===== */
.msg-row-user .bubble {
  float: right;
  clear: right;
  margin-right: 16rpx; /* 与右浮动头像之间 16rpx 间距 */
  max-width: 60%;
  background: #95ec69; /* 浅绿，参考图风格 */
  color: #1a1a1a;
  padding: 16rpx 22rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.5;
  text-align: center;
}

/* 流式打字光标 */
.cursor {
  display: inline-block;
  margin-left: 4rpx;
  color: #07c160;
  font-size: 28rpx;
  animation: blink 1s infinite;
}

/* 列表消息：在深色背景里用深色卡片（与背景区分但不刺眼） */
.bubble-list {
  max-width: 100%;
  padding: 0;
  background: transparent;
  border-radius: 0;
  word-break: normal;
  white-space: normal;
}

.list-head {
  font-size: 25rpx;
  color: #8a8a8e;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.bubble-list .post-card {
  margin-bottom: 16rpx;
}

.bubble-list .post-card:last-child {
  margin-bottom: 0;
}

/* ---------- 帖子卡片（深色风：与背景区分但不那么刺眼） ---------- */
.post-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  /* background: #2a2a2a; */
  /* border-radius: 16rpx;
  padding: 26rpx;
  box-shadow: none; */
}

.post-top {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.post-role {
  background: rgba(7, 193, 96, 0.18);
  color: #2ed477;
  font-size: 26rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.post-location {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-time {
  font-size: 22rpx;
  color: #8a8a8e;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.post-salary {
  font-size: 26rpx;
  color: #ff8a5b;
  margin-bottom: 8rpx;
}

.post-line {
  font-size: 26rpx;
  color: #b8b8b8;
  margin-bottom: 6rpx;
  word-break: break-all;
}

.post-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #8a8a8e;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.post-tag {
  margin: 0 12rpx 8rpx 0;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
}

.post-tag.tag-welfare {
  background: rgba(16, 174, 255, 0.18);
  color: #5ecbff;
}

.post-tag.tag-boss {
  background: rgba(232, 84, 30, 0.18);
  color: #ff8a5b;
}

.post-tag.tag-shop {
  background: rgba(162, 89, 255, 0.18);
  color: #c193ff;
}

@keyframes blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}

/* ============ 底部输入条（深色圆胶囊） ============ */
.footer {
  /* background: #1a1a1a; */
  padding: 20rpx 24rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.input-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 20rpx;
  padding: 20rpx 28rpx;
  background: #fff;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

/* 清空对话按钮 */
.clear-btn {
  width: 60rpx;
  height: 60rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: transparent;
  color: #8a8a8e;
  font-size: 28rpx;
  line-height: 1;
}

.clear-btn-hover {
  opacity: 0.6;
}

.input {
  flex: 1;
  height: 64rpx;
  background: transparent;
  border-radius: 32rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  color: #0e0a0a;
  box-sizing: border-box;
}

.input-placeholder {
  color: #8a8a8e;
}

.send-btn {
  margin-left: 12rpx;
  height: 56rpx;
  padding: 0 24rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  flex-shrink: 0;
}

.send-btn-disabled {
  background: #3a3a3a;
  color: #8a8a8e;
}

.send-btn:active {
  opacity: 0.85;
}

/* ============ 分析类回答（结构化块） ============ */
.a-head {
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
  margin: 8rpx 4rpx 20rpx;
  line-height: 1.4;
}

.a-sub-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 18rpx;
}

/* KPI 数字卡组：渐变卡横滑 */
.a-kpi-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.a-kpi {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  width: 210rpx;
  margin-right: 16rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #10aeff, #6a5af9);
  border-radius: 20rpx;
  box-sizing: border-box;
  vertical-align: top;
}

.a-kpi-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.a-kpi-unit {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 4rpx;
}

.a-kpi-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 白卡片块 */
.a-block {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 案例折叠按钮 */
.cases-toggle {
  margin-top: 8rpx;
  padding: 20rpx 0 4rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 500;
  color: #6a5af9;
}

.cases-toggle:active {
  opacity: 0.6;
}

/* 条形图 */
.a-bar-row {
  margin-bottom: 22rpx;
}

.a-bar-row:last-child {
  margin-bottom: 0;
}

.a-bar-label {
  display: flex;
  align-items: center;
  font-size: 25rpx;
  color: #444;
  margin-bottom: 10rpx;
}

.a-bar-emoji {
  margin-right: 8rpx;
}

.a-bar-name {
  font-weight: 600;
  color: #222;
}

.a-bar-cnt {
  margin-left: 10rpx;
  font-size: 21rpx;
  color: #8a8a8e;
  background: #f2f3f5;
  border-radius: 8rpx;
  padding: 0 10rpx;
}

.a-bar-track {
  height: 22rpx;
  background: #f0f1f3;
  border-radius: 11rpx;
  overflow: hidden;
}

.a-bar-fill {
  height: 100%;
  border-radius: 11rpx;
  background: linear-gradient(90deg, #10aeff, #6a5af9);
}

.a-bar-fill.a-bar-hot {
  background: linear-gradient(90deg, #07c160, #10aeff);
}

.a-bar-range {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a8a8e;
}

.a-bar-range-hot {
  color: #07c160;
  font-weight: 600;
}

/* 洞察块（AI 叙事） */
.a-insight {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #333;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* Tip 提示框 */
.a-tip {
  display: flex;
  align-items: flex-start;
  background: rgba(7, 193, 96, 0.08);
  border: 1rpx solid rgba(7, 193, 96, 0.25);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}

.a-tip-emoji {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.a-tip-text {
  font-size: 26rpx;
  color: #1f7a3d;
  line-height: 1.6;
  flex: 1;
}

/* 引导追问芯片 */
.a-chips {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.a-chip {
  margin: 0 16rpx 16rpx 0;
  padding: 14rpx 26rpx;
  background: #fff;
  border: 1rpx solid #e3e3e3;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: #555;
}

.a-chip:active {
  opacity: 0.7;
}
