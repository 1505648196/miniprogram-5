/* pages/recruit/recruit.wxss */
page {
  background: #f5f5f7;
  height: 100%;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  position: relative;
}

/* ============ 列表区 ============ */
.list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.list-inner {
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 140rpx;
}

.empty-icon {
  font-size: 96rpx;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8a8e;
}

.empty-btn {
  margin-top: 48rpx;
  padding: 22rpx 64rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
}

.empty-btn:active {
  opacity: 0.85;
}

/* 帖子卡片 */
.post-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.post-top {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.post-role {
  background: #e8f8ef;
  color: #07c160;
  font-size: 26rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
}

.post-location {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
}

.post-time {
  font-size: 22rpx;
  color: #b0b0b0;
}

.post-salary {
  font-size: 26rpx;
  color: #e8541e;
  margin-bottom: 8rpx;
}

.post-line {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.post-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #8a8a8e;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 标签条 */
.post-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.post-tag {
  margin: 0 12rpx 8rpx 0;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
}

/* 三组颜色：福利蓝 / 老板橙 / 店铺紫 */
.post-tag.tag-welfare {
  background: #e6f5ff;
  color: #10aeff;
}

.post-tag.tag-boss {
  background: #fff0e8;
  color: #e8541e;
}

.post-tag.tag-shop {
  background: #f3e8ff;
  color: #a259ff;
}

/* 列表底部 */
.list-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #b0b0b0;
}

.publish-entry {
  margin-top: 8rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  color: #07c160;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: 2rpx dashed #07c160;
}

.publish-entry:active {
  opacity: 0.8;
}

/* ============ AI 弹层 ============ */
.ai-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
}

.ai-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72vh;
  background: #f5f5f7;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.ai-panel.ai-open {
  transform: translateY(0);
}

.ai-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #e5e5e5;
  flex-shrink: 0;
}

.ai-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.ai-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8a8e;
}

.ai-close {
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* AI 头部"清空"按钮：灰色描边胶囊，与"收起"区分 */
.ai-clear {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 22rpx;
  margin-right: 16rpx;
  border: 1rpx solid #d8d8d8;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #6a6a6e;
  background: #fff;
}

.ai-clear-hover,
.ai-clear:active {
  opacity: 0.7;
}

.ai-clear-disabled {
  color: #c8c8c8;
  border-color: #ececec;
  pointer-events: none;
}

.ai-msgs {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.ai-hint {
  font-size: 26rpx;
  color: #8a8a8e;
  margin-bottom: 16rpx;
}

.ai-chip {
  display: inline-block;
  margin: 0 16rpx 16rpx 0;
  padding: 14rpx 26rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: #07c160;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.ai-chip:active {
  opacity: 0.8;
}

/* AI 消息行（float 方案：用户气泡自动 shrink-to-fit，绝对不撑满） */
.ai-msg-row {
  margin-bottom: 16rpx;
  overflow: hidden;
  position: relative;
}

/* AI 消息气泡：无背景，黑字直接铺 */
.ai-msg {
  /* display: block;
  word-break: break-all;
  white-space: pre-wrap;
  background: transparent;
  color: #1a1a1a;
  padding: 4rpx 0;
  font-size: 28rpx;
  line-height: 1.6; */
  text-align: left;
}

/* 用户消息气泡：浅绿圆角，紧贴文字，文字居中 */
.ai-msg-row-user .ai-msg {
  float: right;
  clear: right;
  margin-right: 0;
  max-width: 60%;
  background: #95ec69;
  color: #1a1a1a;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  font-size: 27rpx;
  line-height: 1.5;
  text-align: center;
}

/* AI 列表消息：去掉气泡背景/最大宽度，让卡片撑满弹层（与招工列表同款） */
.ai-msg.ai-msg-list {
  max-width: 100%;
  padding: 0;
  background: transparent;
  border-radius: 0;
  word-break: normal;
  white-space: normal;
}

.ai-list-head {
  font-size: 25rpx;
  color: #8a8a8e;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.ai-msg.ai-msg-list .post-card {
  margin-bottom: 16rpx;
}

.ai-msg.ai-msg-list .post-card:last-child {
  margin-bottom: 0;
}

.cursor {
  display: inline-block;
  margin-left: 4rpx;
  color: #07c160;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* AI 输入条 */
.ai-input-row {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5e5e5;
  flex-shrink: 0;
}

.ai-input {
  flex: 1;
  height: 80rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 27rpx;
  box-sizing: border-box;
}

.ph {
  color: #b0b0b0;
}

.ai-send {
  margin-left: 18rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 36rpx;
  background: #07c160;
  color: #fff;
  font-size: 27rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
}

.ai-send-disabled {
  background: #9fe3bd;
}

/* ============ 底部 AI 入口条 ============ */
.ai-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 20rpx;
  padding: 20rpx 28rpx;
  background: #fff;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.ai-bar-text {
  font-size: 26rpx;
  color: #666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-bar-btn {
  margin-left: 20rpx;
  padding: 14rpx 32rpx;
  background: linear-gradient(135deg, #10aeff, #6a5af9);
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.safe-area {
  height: env(safe-area-inset-bottom);
  flex-shrink: 0;
}

/* ============ AI 分析类回答（结构化块） ============ */
.a-head {
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
  margin: 8rpx 4rpx 20rpx;
  line-height: 1.4;
}

.a-sub-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 18rpx;
}

/* KPI 数字卡组：渐变卡横滑 */
.a-kpi-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.a-kpi {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  width: 210rpx;
  margin-right: 16rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #10aeff, #6a5af9);
  border-radius: 20rpx;
  box-sizing: border-box;
  vertical-align: top;
}

.a-kpi-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.a-kpi-unit {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 4rpx;
}

.a-kpi-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 白卡片块 */
.a-block {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 案例折叠按钮 */
.cases-toggle {
  margin-top: 8rpx;
  padding: 20rpx 0 4rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 500;
  color: #6a5af9;
}

.cases-toggle:active {
  opacity: 0.6;
}

/* 条形图 */
.a-bar-row {
  margin-bottom: 22rpx;
}

.a-bar-row:last-child {
  margin-bottom: 0;
}

.a-bar-label {
  display: flex;
  align-items: center;
  font-size: 25rpx;
  color: #444;
  margin-bottom: 10rpx;
}

.a-bar-emoji {
  margin-right: 8rpx;
}

.a-bar-name {
  font-weight: 600;
  color: #222;
}

.a-bar-cnt {
  margin-left: 10rpx;
  font-size: 21rpx;
  color: #8a8a8e;
  background: #f2f3f5;
  border-radius: 8rpx;
  padding: 0 10rpx;
}

.a-bar-track {
  height: 22rpx;
  background: #f0f1f3;
  border-radius: 11rpx;
  overflow: hidden;
}

.a-bar-fill {
  height: 100%;
  border-radius: 11rpx;
  background: linear-gradient(90deg, #10aeff, #6a5af9);
}

.a-bar-fill.a-bar-hot {
  background: linear-gradient(90deg, #07c160, #10aeff);
}

.a-bar-range {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a8a8e;
}

.a-bar-range-hot {
  color: #07c160;
  font-weight: 600;
}

/* 洞察块（AI 叙事） */
.a-insight {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #333;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* Tip 提示框 */
.a-tip {
  display: flex;
  align-items: flex-start;
  background: rgba(7, 193, 96, 0.08);
  border: 1rpx solid rgba(7, 193, 96, 0.25);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}

.a-tip-emoji {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.a-tip-text {
  font-size: 26rpx;
  color: #1f7a3d;
  line-height: 1.6;
  flex: 1;
}

/* 引导追问芯片 */
.a-chips {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.a-chip {
  margin: 0 16rpx 16rpx 0;
  padding: 14rpx 26rpx;
  background: #fff;
  border: 1rpx solid #e3e3e3;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: #555;
}

.a-chip:active {
  opacity: 0.7;
}

/* ============ 发布交互卡（confirm / draft_continue） ============ */
.p-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border-left: 8rpx solid #07c160;
}

.p-card-draft {
  border-left-color: #ff9500;
}

/* 草稿提示卡（draft_pending）：紫色左边框，与"待用户决策"语义匹配 */
.p-card-pending {
  border-left-color: #a259ff;
}

.p-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.p-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111;
}

.p-card-tag {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8ef;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.p-card-tag-warn {
  color: #e8541e;
  background: #fff0e8;
}

.p-card-reply {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.p-fields {
  background: #f8f8fa;
  border-radius: 16rpx;
  padding: 8rpx 20rpx;
  margin-bottom: 16rpx;
}

.p-field-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 26rpx;
}

.p-field-row:last-child {
  border-bottom: none;
}

.p-field-emoji {
  margin-right: 12rpx;
}

.p-field-label {
  width: 110rpx;
  color: #8a8a8e;
  flex-shrink: 0;
}

.p-field-value {
  flex: 1;
  color: #1a1a1a;
  font-weight: 600;
  text-align: right;
}

.p-missing {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  background: #fff7e8;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
  font-size: 25rpx;
  color: #b25e00;
}

.p-missing-icon {
  margin-right: 8rpx;
}

.p-missing-text {
  margin-right: 6rpx;
}

.p-missing-item {
  margin-right: 12rpx;
  background: #fff;
  border: 1rpx solid #ffd591;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.p-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.p-tag {
  margin: 0 12rpx 8rpx 0;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 23rpx;
  background: #e6f5ff;
  color: #10aeff;
}

.p-btn-row {
  display: flex;
  margin-top: 8rpx;
}

.p-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.p-btn-primary {
  background: #07c160;
  color: #fff;
  margin-right: 16rpx;
}

.p-btn-ghost {
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.p-btn:active {
  opacity: 0.85;
}

.p-btn-inline {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: #fff;
  border: 1rpx solid #10aeff;
  color: #10aeff;
  border-radius: 30rpx;
  font-size: 25rpx;
}

.p-btn-inline:active {
  opacity: 0.8;
}

/* 查询回复下方的"我要发布招工"切换芯片 */
.p-tipchip {
  display: inline-flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 12rpx 26rpx;
  background: #fff;
  border: 1rpx solid #07c160;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: #07c160;
}

.p-tipchip-icon {
  margin-right: 8rpx;
}

.p-tipchip:active {
  opacity: 0.8;
}

/* ============ 发布成功弹层 ============ */
.pub-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.pub-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 56rpx 40rpx 40rpx;
  z-index: 210;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.16);
  text-align: center;
}

.pub-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto;
  background: #e8f8ef;
  color: #07c160;
  font-size: 64rpx;
  border-radius: 50%;
}

.pub-title {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.pub-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #8a8a8e;
}

.pub-summary {
  margin-top: 28rpx;
  background: #f8f8fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.pub-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.pub-label {
  color: #8a8a8e;
}

.pub-value {
  color: #1a1a1a;
  font-weight: 600;
}

.pub-btns {
  margin-top: 36rpx;
  display: flex;
}

.pub-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.pub-btn-primary {
  background: #07c160;
  color: #fff;
  margin-right: 20rpx;
}

.pub-btn-ghost {
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.pub-btn:active {
  opacity: 0.85;
}
