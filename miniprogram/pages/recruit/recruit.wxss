/* pages/recruit/recruit.wxss */
/* 包子行业信息平台  招工频道页  TDesign CSS 变量覆盖，不改组件源码 */

.page {
  min-height: 100vh;
  padding-bottom: 64rpx;
}

/* ============ 黄色 Header ============ */
.header {
  height: 88rpx;
  background: #FFE60A;
  display: flex;
  align-items: center;
  padding: 0 16rpx 0 24rpx;
  gap: 16rpx;
}

.header-logo {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 1rpx;
  flex-shrink: 0;
  width: 128rpx;
  white-space: nowrap;
}

.hdr-search {
  flex: 1;
  min-width: 0;
}

.hdr-publish {
  flex-shrink: 0;
  --td-button-bg-color: #1A1A1A;
  --td-button-border-color: #1A1A1A;
  --td-button-font: 24rpx;
}

/* ============ 品牌区 ============ */
.brand {
  background: #FFFFFF;
  padding: 24rpx 32rpx 8rpx;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #FF4D4F;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.brand-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

/* ============ 主内容 ============ */
.content {
  background: #FFFFFF;
  padding: 0 16rpx;
  border-radius: 0 0 24rpx 24rpx;
}

/* ============ 金刚位 8 宫格 ============ */
.kk {
  padding: 16rpx 0 8rpx;
  --td-grid-item-padding: 20rpx 0;
}

.kk-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
  box-sizing: border-box;
  border: 4rpx solid transparent;
}

.kk-icon.is-active {
  border-color: #FFE60A;
  /* 选中时黄色光晕+放大，更明显（背景由 inline style 控制,用阴影+缩放表达亮起） */
  box-shadow: 0 0 0 5rpx rgba(255, 230, 10, 0.6), 0 0 22rpx 6rpx rgba(255, 230, 10, 0.5);
  transform: scale(1.12);
  transition: all 0.2s ease;
}

.kk-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #1A1A1A;
}

/* 第 10 格"更多类型/收起"入口：品牌金色底 + 黑色向下/向上箭头（与下拉"确定"按钮同款品牌色） */
.kk-more {
  background: #FFE60A !important;
  color: #1A1A1A;
}

.kk-more-arrow {
  color: #1A1A1A;
  transition: transform 0.2s ease;
}

.kk-more-arrow.is-up {
  transform: rotate(180deg);
}

/* 展开后下方的额外金刚位：与上方金刚位相同的 padding，避免紧贴 */
.kk-extra {
  border-top: 1rpx dashed #F0F0F0;
}

/* ============ 广告轮播位（ads 为空时整块不渲染） ============ */
.ads {
  padding: 16rpx 0 0;
}

.ads-swiper {
  border-radius: 20rpx;
  overflow: hidden;
}

/* ============ Banner 运营卡位 ============ */
.banners {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0 0;
}

.banner {
  flex: 1;
  min-width: 0;
  height: 108rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.banner-emoji {
  font-size: 48rpx;
  flex-shrink: 0;
  line-height: 1;
}

.banner-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.banner-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.banner-sub {
  font-size: 22rpx;
  color: #666666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ============ 服务保障数字卡位 ============ */
.stats {
  display: flex;
  padding: 24rpx 0 8rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 0;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #FF7A45;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

/* ============ 顶部下拉筛选条(师傅类型 / 区域 / 工资) ============ */
.top-dropdown {
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
  --td-dropdown-menu-bg-color: #ffffff;
}

/* 吸顶态：纯白底 + 底部阴影，避免下方内容透出、层次更清晰 */
.top-dropdown.is-sticky {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 选中态：区域/工资菜单项展开时 黄底 + 黑字加粗 */
.top-dropdown .t-dropdown-menu__item--active {
  color: #1A1A1A;
  font-weight: 700;
  background: #FFE60A;
}

/* 筛选"有值时"菜单项常亮（区别于展开态金底黑字：这里用品牌橙字加粗、无背景）
   通过 nth-child(1/2/3) 精准定位 师傅类型/区域/工资 三项；父类 has-* 控制是否生效
   apply-shared 下页面 wxss 可影响 dropdown-menu 内部样式 */
.top-dropdown.has-sub .t-dropdown-menu__item:nth-child(1) .t-dropdown-menu__title,
.top-dropdown.has-sub .t-dropdown-menu__item:nth-child(1) .t-dropdown-menu__icon,
.top-dropdown.has-region .t-dropdown-menu__item:nth-child(2) .t-dropdown-menu__title,
.top-dropdown.has-region .t-dropdown-menu__item:nth-child(2) .t-dropdown-menu__icon,
.top-dropdown.has-salary .t-dropdown-menu__item:nth-child(3) .t-dropdown-menu__title,
.top-dropdown.has-salary .t-dropdown-menu__item:nth-child(3) .t-dropdown-menu__icon {
  color: #FF7A45;
  font-weight: 700;
}

/* 下拉展开时不再盖半透明遮罩（避免页面变暗/变糊），仅作用于本页 dropdown */
.top-dropdown .t-dropdown-item__mask {
  background: transparent;
}
/* 强制把 popup 的 t-overlay(默认 rgba(0,0,0,.6))设为透明，彻底解决糊 */
.top-dropdown .t-overlay {
  background-color: transparent !important;
  opacity: 0 !important;
}

/* ===== 信息类别：招聘/求职 横向卡片多选(t-checkbox-group) =====
   替代原类别下拉；勾选卡片控制列表数据源(两类全勾=全部混排) */
.type-check {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx 6rpx;
  margin-top: 12rpx;
  background: #fff;
  /* checkbox 组件背景改为透明，露出外层卡片的灰底/选中橙底；并压缩其内部纵向内边距 */
  --td-checkbox-bg-color: transparent;
  --td-checkbox-vertical-padding: 8rpx;
}
.type-check-title {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #999999;
  margin-right: 16rpx;
}
/* t-checkbox-group 根：横向排"招聘/求职/会员"三张多选卡 */
.type-check-list {
  flex: 1;
  display: flex;
  min-width: 0;
}
/* 每张卡片：灰底描边，勾选(is-on)高亮橙；右上角浮 check 图标
   文字由内部 checkbox 提供内边距，此处仅负责卡片边框/底色/裁切 */
.type-check-item {
  position: relative;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  border: 2rpx solid #ECECEC;
  border-radius: 16rpx;
  background: #FAFAFA;
  box-sizing: border-box;
  transition: all 0.2s;
  overflow: hidden;
  /* 卡片文字水平居中(text-align 继承到 checkbox 内部 __title 文字) */
  text-align: center;
}
.type-check-item:last-child {
  margin-right: 0;
}
.type-check-item.is-on {
  border-color: #FF7A45;
  background: #FFF1E8;
}
/* 右上角对勾图标 */
.type-check-check {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  color: #FF7A45;
  font-size: 28rpx;
  z-index: 1;
  pointer-events: none;
}
.type-check-label {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
/* checkbox 内部 __title 默认 line-height:48rpx + font-size:32rpx，会让文字"挤叠"。
   显式给 name/desc 设匹配的 line-height + display:block，避免两行重叠；
   text-align:center 让卡片内文字水平居中 */
.type-check-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 48rpx;
  min-height: 48rpx;
  text-align: center;
}
.type-check-item.is-on .type-check-name {
  color: #FF7A45;
}
.type-check-desc {
  display: block;
  font-size: 22rpx;
  color: #999999;
  line-height: 44rpx;
  min-height: 44rpx;
  margin-top: 4rpx;
  text-align: center;
}

/* ===== 师傅类型下拉内容(单选列表，点击即选即生效) ===== */
.drop-sub {
  padding: 24rpx 0 0;
}

.drop-sub-title {
  padding: 0 32rpx 16rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 单选列表(滚动) */
.drop-sub-list {
  display: flex;
  flex-direction: column;
  padding: 0 16rpx;
  max-height: 520rpx;
  overflow-y: auto;
}

.drop-sub-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
  font-size: 28rpx;
  color: #1A1A1A;
}

.drop-sub-row-label {
  flex: 1;
}

.drop-sub-row-tick {
  color: #FF7A45;
  font-size: 32rpx;
  font-weight: 700;
}

/* 选中态：浅橙底 */
.drop-sub-row.is-on {
  background: #FFF1E8;
  color: #FF7A45;
  font-weight: 700;
}

/* ===== 区域下拉内容 ===== */
.drop-region {
  padding: 32rpx 32rpx 40rpx;
}

.drop-region-title {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 20rpx;
}

.drop-region-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

/* 常用城市外层包装：保证 tap 点击区域与标签一致，不被 flex 拉伸 */
.drop-city-wrap {
  display: inline-flex;
}

/* 常用城市标签 */
.drop-city-tag {
  margin: 0;
  --td-tag-large-height: 72rpx;
  --td-tag-large-font-size: 30rpx;
  --td-tag-large-padding: 32rpx;
  --td-tag-round-border-radius: 36rpx;
  --td-tag-default-light-color: #F5F5F5;
  --td-tag-default-font-color: #4A4A4A;
}

/* 选中态:浅橙底 + 品牌橙字 */
.drop-city-tag.is-on {
  --td-tag-default-light-color: #FFF1E8;
  --td-tag-default-font-color: #FF7A45;
  --td-tag-primary-color: #FF7A45;
}

/* 按钮行：选择完整省市区(左) + 重置(右) 各占一边 */
.drop-region-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-top: 32rpx;
}

.drop-region-more {
  flex: 0 0 auto;
  min-width: 0;
  --td-button-font: 28rpx;
  /* 闲鱼黄底 + 黑字（theme=primary 需覆盖 primary 变量） */
  --td-button-primary-bg-color: #FFE60A;
  --td-button-primary-border-color: #FFE60A;
  --td-button-primary-color: #1A1A1A;
  --td-button-primary-active-bg-color: #F5D800;
  --td-button-primary-active-border-color: #F5D800;
}

.drop-region-reset {
  flex: 0 0 auto;
  --td-button-font: 28rpx;
  --td-button-color: #999999;
}

/* ===== 工资下拉内容 ===== */
.drop-salary {
  padding: 32rpx 32rpx 40rpx;
}

.drop-salary-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.drop-salary-input {
  flex: 1;
  min-width: 0;
  --td-input-bg-color: #F5F5F5;
  --td-input-border-color: transparent;
  --td-input-padding: 24rpx;
}

.drop-salary-unit {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
  flex-shrink: 0;
}

.drop-salary-tip {
  font-size: 22rpx;
  color: #999999;
  margin: 16rpx 0 24rpx;
  text-align: center;
}

.drop-salary-actions {
  display: flex;
  gap: 16rpx;
}

.drop-salary-btn-reset,
.drop-salary-btn-confirm {
  flex: 1;
  --td-button-font: 30rpx;
  --td-button-height: 88rpx;
}

.drop-salary-btn-confirm {
  /* 闲鱼黄底 + 黑字（theme=primary 需覆盖 primary 变量） */
  --td-button-primary-bg-color: #FFE60A;
  --td-button-primary-border-color: #FFE60A;
  --td-button-primary-color: #1A1A1A;
  --td-button-primary-active-bg-color: #F5D800;
  --td-button-primary-active-border-color: #F5D800;
}

/* ============ 帖子流容器 ============ */
.feed {
  background: #FFFFFF;
  padding: 0 16rpx;
}

/* ============ 帖子双列 ============ */
.goods {
  display: flex;
  gap: 8rpx;
  padding: 6rpx 0 16rpx;
}

.goods-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.goods-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 无图时，地区·时间行内的业务类型高亮小标签（品牌色底 + 白字圆角） */
.goods-meta-type {
  flex-shrink: 0;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  max-width: 40%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-img {
  width: 100%;
  aspect-ratio: 4 / 3;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 定位上下文：让 .goods-type 绝对定位锚定在图片内（左上角徽章） */
  position: relative;
}

.goods-emoji {
  font-size: 84rpx;
  line-height: 1;
}

/* 帖子图片：填满 4:3 图片容器（仅 item.image 有值时渲染） */
.goods-pic {
  width: 100%;
  height: 100%;
  display: block;
}

.goods-type {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.4;
  max-width: 70%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-title {
  font-size: 26rpx;
  color: #1A1A1A;
  line-height: 1.4;
  padding: 16rpx 16rpx 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 12rpx 16rpx 0;
}

.goods-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999999;
  padding: 8rpx 16rpx 0;
  white-space: nowrap;
  overflow: hidden;
}

/* 发布用户昵称/称呼（有 username 才展示）；昵称 + 信用标签横排 */
.goods-user {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #666666;
  padding: 8rpx 16rpx 0;
  white-space: nowrap;
  overflow: hidden;
}

/* 信用评分标签（有 credit 才显示；颜色/底色由 creditMeta 内联控制） */
.goods-credit {
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 1;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
}

.goods-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 16rpx 16rpx;
  gap: 8rpx;
}

.goods-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF7A45;
  line-height: 1.2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-arrow {
  font-size: 20rpx;
  color: #999999;
  flex-shrink: 0;
}

.goods-loading,
.goods-empty {
  padding: 80rpx 0;
  display: flex;
  justify-content: center;
}

/* 列表加载骨架屏：与真实帖子流同款左右留白与上下间距 */
.feed-skeleton {
  padding: 32rpx 0 16rpx;
}

/* 触底加载更多 / 没有更多 */
.feed-footer {
  padding: 16rpx 0 40rpx;
  display: flex;
  justify-content: center;
}

.feed-end-text {
  font-size: 22rpx;
  color: #cccccc;
}
