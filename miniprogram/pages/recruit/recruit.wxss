/* pages/recruit/recruit.wxss */
page {
  background: #f5f5f7;
  height: 100%;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  position: relative;
}

/* ============ 列表区 ============ */
.list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.list-inner {
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 140rpx;
}

.empty-icon {
  font-size: 96rpx;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8a8e;
}

.empty-btn {
  margin-top: 48rpx;
  padding: 22rpx 64rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
}

.empty-btn:active {
  opacity: 0.85;
}

/* 帖子卡片 */
.post-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.post-top {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.post-role {
  background: #e8f8ef;
  color: #07c160;
  font-size: 26rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
}

.post-location {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
}

.post-time {
  font-size: 22rpx;
  color: #b0b0b0;
}

.post-salary {
  font-size: 26rpx;
  color: #e8541e;
  margin-bottom: 8rpx;
}

.post-line {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.post-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #8a8a8e;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 标签条 */
.post-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.post-tag {
  margin: 0 12rpx 8rpx 0;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
}

/* 三组颜色：福利蓝 / 老板橙 / 店铺紫 */
.post-tag.tag-welfare {
  background: #e6f5ff;
  color: #10aeff;
}

.post-tag.tag-boss {
  background: #fff0e8;
  color: #e8541e;
}

.post-tag.tag-shop {
  background: #f3e8ff;
  color: #a259ff;
}

/* 列表底部 */
.list-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #b0b0b0;
}

.publish-entry {
  margin-top: 8rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  color: #07c160;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: 2rpx dashed #07c160;
}

.publish-entry:active {
  opacity: 0.8;
}

/* ============ AI 弹层 ============ */
.ai-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
}

.ai-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72vh;
  background: #f5f5f7;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.ai-panel.ai-open {
  transform: translateY(0);
}

.ai-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #e5e5e5;
  flex-shrink: 0;
}

.ai-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.ai-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8a8e;
}

.ai-close {
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.ai-msgs {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.ai-hint {
  font-size: 26rpx;
  color: #8a8a8e;
  margin-bottom: 16rpx;
}

.ai-chip {
  display: inline-block;
  margin: 0 16rpx 16rpx 0;
  padding: 14rpx 26rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: #07c160;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.ai-chip:active {
  opacity: 0.8;
}

/* AI 消息行（float 方案：用户气泡自动 shrink-to-fit，绝对不撑满） */
.ai-msg-row {
  margin-bottom: 16rpx;
  overflow: hidden;
  position: relative;
}

/* AI 消息气泡：无背景，黑字直接铺 */
.ai-msg {
  /* display: block;
  word-break: break-all;
  white-space: pre-wrap;
  background: transparent;
  color: #1a1a1a;
  padding: 4rpx 0;
  font-size: 28rpx;
  line-height: 1.6; */
  text-align: left;
}

/* 用户消息气泡：浅绿圆角，紧贴文字，文字居中 */
.ai-msg-row-user .ai-msg {
  float: right;
  clear: right;
  margin-right: 0;
  max-width: 60%;
  background: #95ec69;
  color: #1a1a1a;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  font-size: 27rpx;
  line-height: 1.5;
  text-align: center;
}

/* AI 列表消息：去掉气泡背景/最大宽度，让卡片撑满弹层（与招工列表同款） */
.ai-msg.ai-msg-list {
  max-width: 100%;
  padding: 0;
  background: transparent;
  border-radius: 0;
  word-break: normal;
  white-space: normal;
}

.ai-list-head {
  font-size: 25rpx;
  color: #8a8a8e;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.ai-msg.ai-msg-list .post-card {
  margin-bottom: 16rpx;
}

.ai-msg.ai-msg-list .post-card:last-child {
  margin-bottom: 0;
}

.cursor {
  display: inline-block;
  margin-left: 4rpx;
  color: #07c160;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* AI 输入条 */
.ai-input-row {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5e5e5;
  flex-shrink: 0;
}

.ai-input {
  flex: 1;
  height: 80rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 27rpx;
  box-sizing: border-box;
}

.ph {
  color: #b0b0b0;
}

.ai-send {
  margin-left: 18rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 36rpx;
  background: #07c160;
  color: #fff;
  font-size: 27rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
}

.ai-send-disabled {
  background: #9fe3bd;
}

/* ============ 底部 AI 入口条 ============ */
.ai-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 20rpx;
  padding: 20rpx 28rpx;
  background: #fff;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.ai-bar-text {
  font-size: 26rpx;
  color: #666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-bar-btn {
  margin-left: 20rpx;
  padding: 14rpx 32rpx;
  background: linear-gradient(135deg, #10aeff, #6a5af9);
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}

.safe-area {
  height: env(safe-area-inset-bottom);
  flex-shrink: 0;
}
