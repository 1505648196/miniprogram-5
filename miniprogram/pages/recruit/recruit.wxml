<!-- pages/recruit/recruit.wxml -->
<!-- 包子行业信息平台 · 招聘求职频道页 —— TDesign(tdesign-miniprogram) -->
<!-- 运营位（轮播 / Banner / 数字卡）在数组为空时整块不渲染，不留占位 -->
<wxs src="./contain.wxs" module="tc" />
<view class="page">

  <!-- 模块 1:黄色 Header:Logo | t-search | t-button 发布 -->
  <!-- <view class="header">
    <view class="header-logo">包子一哥</view>
    <t-search
      class="hdr-search"
      shape="round"
      placeholder="搜索 招工岗位/城市…"
      clearable="{{true}}"image.png
      bind:change="onSearch"
    />
    <t-button
      class="hdr-publish"
      size="small"
      theme="default"
      shape="round"
      variant="dark"
      bind:tap="onPublish"
    >
      发布
    </t-button>
  </view> -->

  <!-- 模块 2:品牌区(常显) -->
  <!-- <view class="brand">
    <view class="brand-title">我要招聘</view>
    <view class="brand-sub">招心动啦 · 包子行业专业招工频道</view>
  </view> -->

  <view class="content">

    <!-- 模块 3:金刚位(师傅类型) · 默认 9 个 + 第 10 格"更多"，点更多下方展示剩余 5 个 -->
    <t-grid class="kk" column="{{5}}" hover>
      <t-grid-item
        wx:for="{{visibleSubCats}}" wx:key="id"
        data-item="{{item}}" bind:click="onSubCat"
      >
        <view class="kk-icon {{activeSub === item.id ? 'is-active' : ''}}" style="background: {{item.bg}};">{{item.emoji}}</view>
        <view class="kk-name">{{item.name}}</view>
      </t-grid-item>
      <!-- 第 10 格：更多类型/收起 入口（占用"生煎类师傅"的格子；向下箭头=更多，展开后向上箭头=收起） -->
      <t-grid-item bind:click="toggleSubExpand">
        <view class="kk-icon kk-more">
          <t-icon class="kk-more-arrow {{subExpanded ? 'is-up' : ''}}" name="chevron-down" size="52rpx" />
        </view>
        <view class="kk-name">{{subExpanded ? '收起' : '更多类型'}}</view>
      </t-grid-item>
    </t-grid>

    <!-- 展开后下方展示剩余品类（默认隐藏） -->
    <t-grid class="kk kk-extra" wx:if="{{subExpanded}}" column="{{5}}" hover>
      <t-grid-item
        wx:for="{{extraSubCats}}" wx:key="id"
        data-item="{{item}}" bind:click="onSubCat"
      >
        <view class="kk-icon {{activeSub === item.id ? 'is-active' : ''}}" style="background: {{item.bg}};">{{item.emoji}}</view>
        <view class="kk-name">{{item.name}}</view>
      </t-grid-item>
    </t-grid>

    <!-- 模块 4:广告轮播位(ads 为空时整块不渲染) -->
    <view class="ads" wx:if="{{ads.length}}">
      <t-swiper
        class="ads-swiper"
        list="{{ads}}"
        height="{{200}}"
        autoplay="{{true}}"
        interval="{{5000}}"
        navigation="{{swiperNav}}"
        bind:click="onAdTap"
      />
    </view>

    <!-- 模块 5:Banner 运营卡位(banners 为空时整块不渲染) -->
    <view class="banners" wx:if="{{banners.length}}">
      <view
        class="banner"
        wx:for="{{banners}}" wx:key="id"
        style="background: linear-gradient(135deg, {{item.bgFrom}} 0%, {{item.bgTo}} 100%);"
        data-item="{{item}}" bindtap="onBannerTap"
      >
        <view class="banner-emoji">{{item.emoji}}</view>
        <view class="banner-info">
          <view class="banner-title">{{item.title}}</view>
          <view class="banner-sub">{{item.sub}}</view>
        </view>
      </view>
    </view>

    <!-- 模块 6:服务保障数字卡位(stats 为空时整块不渲染) -->
    <view class="stats" wx:if="{{stats.length}}">
      <view class="stat" wx:for="{{stats}}" wx:key="id">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>

  </view>

  <!-- 模块 7 已临时隐藏：用 wx:if="{{false}}" 不渲染（WXML 注释不能嵌套，故不用注释包裹）。
       恢复时把 false 改回 filterBarVisible 即可。 -->
  <block >
  <t-sticky
    offset-top="{{stickyTop}}"
    z-index="{{20000}}"
    bind:scroll="onStickyScroll"
  >
  <t-dropdown-menu id="topDropdownMenu" class="top-dropdown {{tabsSticky ? 'is-sticky' : ''}} {{subPick && subPick !== '__all__' ? 'has-sub' : ''}} {{regionPick ? 'has-region' : ''}} {{salary ? 'has-salary' : ''}}" show-overlay="{{false}}">

    <!-- 师傅类型:下拉面板内嵌单选列表，点击即选即生效 -->
    <t-dropdown-item id="subDropdownItem" label="{{subLabel}}" bind:open="onSubDropdownOpen">
      <view class="drop-sub">
        <view class="drop-sub-title">选择师傅类型</view>
        <view class="drop-sub-list">
          <view
            wx:for="{{subOptions}}" wx:key="value"
            data-value="{{item.value}}"
            class="drop-sub-row {{subDraftPick === item.value ? 'is-on' : ''}}"
            bind:tap="onSubRowTap"
          >
            <text class="drop-sub-row-label">{{item.label}}</text>
            <text wx:if="{{subDraftPick === item.value}}" class="drop-sub-row-tick">✓</text>
          </view>
        </view>
      </view>
    </t-dropdown-item>

    <!-- 区域:下拉内常用城市快捷选择 + 完整省市区(t-cascader) -->
    <t-dropdown-item id="regionDropdownItem" label="{{regionPick || '区域'}}" bind:open="onRegionDropdownOpen">
      <view class="drop-region">
        <view class="drop-region-title">常用城市</view>
        <view class="drop-region-tags">
          <view
            wx:for="{{hotCities}}" wx:key="code"
            class="drop-city-wrap {{regionCode === item.code ? 'is-on' : ''}}"
            data-name="{{item.name}}"
            data-code="{{item.code}}"
            bind:tap="onHotCity"
          >
            <t-tag
              size="extra-large" variant="light"
              class="drop-city-tag {{regionCode === item.code ? 'is-on' : ''}}"
            >{{item.name}}</t-tag>
          </view>
        </view>
        <view class="drop-region-actions">
          <t-button
            class="drop-region-more"
            theme="primary"
            bind:tap="openCascader"
          >查看完整省市区</t-button>
          <t-button
            wx:if="{{regionPick}}"
            class="drop-region-reset"
            theme="default" variant="text"
            bind:tap="onRegionReset"
          >重置</t-button>
        </view>
      </view>
    </t-dropdown-item>
  
  
    <!-- 工资:下拉内输入最低薪资 + 清空/确定 -->
    <t-dropdown-item id="salaryDropdownItem" label="{{salaryLabel}}">
      <view class="drop-salary">
        <view class="drop-salary-row">
          <t-input
            key="salary-{{salaryInputKey}}"
            class="drop-salary-input"
            type="number" placeholder="最低薪资"
            maxlength="6"
            value="{{salary}}"
            bind:change="onSalary"
            bind:blur="onSalaryBlur"
          />
          <text class="drop-salary-unit">元/月</text>
        </view>
        <view class="drop-salary-tip">限填数字，最高 10 万元/月</view>
        <view class="drop-salary-actions">
          <t-button class="drop-salary-btn-reset" theme="default" variant="outline" bind:tap="onSalaryClear">清空</t-button>
          <t-button class="drop-salary-btn-confirm" theme="primary" bind:tap="onSalaryConfirm">确定</t-button>
        </view>
      </view>
    </t-dropdown-item>
  </t-dropdown-menu>
  </t-sticky>
  </block>

  <!-- 模块 7.5:信息类别(招聘/求职)多选卡片 · TDesign t-checkbox-group -->
  <!-- value=selectedTypes(勾选数组)：两类全勾=全部混排；取消任一=只看另一类；全不勾自动回两类全看 -->
  <!-- 卡片激活态由 tc.contain(selectedTypes, item.value) 判断；勾选图标用 t-icon check，checkbox 本体 icon="none" -->
  <!-- 打开"查看完整省市区"弹层时整组隐藏，避免遮挡 cascader(与上方 sticky 同步控制) -->
     <!-- <view class="type-check-title">信息类别</view> -->
    <!-- 招聘/求职/会员 都作为多选卡(同组件)；筛选时只认 recruit/jobseek，member 触发也返回空不影响 -->
  <block wx:if="{{filterBarVisible}}">
  <view class="type-check">
 
    <t-checkbox-group
      class="type-check-list"
      value="{{selectedTypes}}"
      bind:change="onTypeChange"
    >
      <view
        wx:for="{{typeCards}}" wx:key="value"
        class="type-check-item {{tc.contain(selectedTypes, item.value) ? 'is-on' : ''}}"
      >
        <t-icon
          wx:if="{{tc.contain(selectedTypes, item.value)}}"
          name="check"
          t-class="type-check-check"
          ariaHidden="{{true}}"
        />
        <t-checkbox value="{{item.value}}" icon="none" borderless>
          <view class="type-check-label">
            <view class="type-check-name">{{item.label}}</view>
            <view class="type-check-desc">{{item.desc}}</view>
          </view>
        </t-checkbox>
      </view>
    </t-checkbox-group>
  </view>
  </block>

  <!-- 模块 8:招聘求职信息双列瀑布流 -->
  <!-- loading 时展示双列卡片骨架屏(t-skeleton)；否则按 空态/列表 渲染 -->
  <view class="feed">
    <t-skeleton
      wx:if="{{loading}}"
      class="feed-skeleton"
      theme="paragraph"
      animation="flashed"
      row-col="{{skeletonRows}}"
    />
    <view class="goods-empty" wx:elif="{{!goodsLeft.length && !goodsRight.length}}">
      <t-empty icon="search" description="{{emptyText}}" />
    </view>

    <view class="goods" wx:else>
      <view class="goods-col">
        <view class="goods-card"
              wx:for="{{goodsLeft}}" wx:key="id"
              data-id="{{item.id}}" bindtap="onTap">
          <!-- 有图时显示真实图片 + 类型徽章；无图则整块不渲染（含 emoji） -->
          <view class="goods-img" wx:if="{{item.image}}" style="background: {{item.light}};">
            <image class="goods-pic" src="{{item.image}}" mode="widthFix" />
            <view class="goods-type" style="background: {{item.color}};">{{item.typeName}}</view>
          </view>
          <view class="goods-title">{{item.title}}</view>
          <view class="goods-tags" wx:if="{{item.tags.length}}">
            <t-tag wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this" size="small" variant="light" t-class="goods-tag">{{tg}}</t-tag>
          </view>
          <!-- 发布用户昵称/称呼：有值才展示；旁边附信用评分标签（有 credit 才显示） -->
          <view class="goods-user" wx:if="{{item.username}}">
            <t-icon name="user" size="24rpx" color="#FFE60A" />
            <text>{{item.username}}</text>
            <text class="goods-credit" wx:if="{{item.creditMeta}}" style="color: {{item.creditMeta.color}}; background: {{item.creditMeta.bg}};">{{item.creditMeta.label}}</text>
          </view>
          <!-- 地区·时间 行：无图时在前面补业务类型高亮标签 -->
          <view class="goods-meta">
            <text wx:if="{{!item.image}}" class="goods-meta-type" style="background: {{item.color}};">{{item.typeName}}</text>
            <text>{{item.meta}}</text>
          </view>
          <view class="goods-price-row">
            <view class="goods-price">{{item.priceText}}</view>
            <view class="goods-arrow">查看 ›</view>
          </view>
        </view>
      </view>
      <view class="goods-col">
        <view class="goods-card"
              wx:for="{{goodsRight}}" wx:key="id"
              data-id="{{item.id}}" bindtap="onTap">
          <!-- 有图时显示真实图片 + 类型徽章；无图则整块不渲染（含 emoji） -->
          <view class="goods-img" wx:if="{{item.image}}" style="background: {{item.light}};">
            <image class="goods-pic" src="{{item.image}}" mode="widthFix" />
            <view class="goods-type" style="background: {{item.color}};">{{item.typeName}}</view>
          </view>
          <view class="goods-title">{{item.title}}</view>
          <view class="goods-tags" wx:if="{{item.tags.length}}">
            <t-tag wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this" size="small" variant="light" t-class="goods-tag">{{tg}}</t-tag>
          </view>
          <!-- 发布用户昵称/称呼：有值才展示；旁边附信用评分标签（有 credit 才显示） -->
          <view class="goods-user" wx:if="{{item.username}}">
            <t-icon name="user" size="24rpx" color="#FFE60A" />
            <text>{{item.username}}</text>
            <text class="goods-credit" wx:if="{{item.creditMeta}}" style="color: {{item.creditMeta.color}}; background: {{item.creditMeta.bg}};">{{item.creditMeta.label}}</text>
          </view>
          <!-- 地区·时间 行：无图时在前面补业务类型高亮标签 -->
          <view class="goods-meta">
            <text wx:if="{{!item.image}}" class="goods-meta-type" style="background: {{item.color}};">{{item.typeName}}</text>
            <text>{{item.meta}}</text>
          </view>
          <view class="goods-price-row">
            <view class="goods-price">{{item.priceText}}</view>
            <view class="goods-arrow">查看 ›</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 触底加载更多状态：加载中=局部 loading，到底=没有更多（局部反馈，不切骨架屏） -->
    <view class="feed-footer">
      <t-loading wx:if="{{loadingMore}}" theme="circular" size="32rpx" text="加载更多…" layout="vertical" />
      <text wx:elif="{{firstLoaded && !hasMore && !loading}}" class="feed-end-text">— 没有更多了 —</text>
    </view>
  </view>

  <!-- ========== 模块 9:区域选择弹层(t-cascader) ========== -->
  <!-- 由 openCascader 先关闭 dropdown 再打开,无弹层冲突 -->
  <t-cascader
    visible="{{regionVisible}}"
    title="选择城市"
    options="{{regionOptions}}"
    theme="tab"
    filterable="{{true}}"
    filter-placeholder="搜索城市/区域"
    bind:change="onRegionChange"
    bind:pick="onRegionPick"
    bind:close="onRegionClose"
  />

</view>
