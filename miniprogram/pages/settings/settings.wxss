/* pages/settings/settings.wxss */

.page {
  min-height: 100vh;
  padding: 24rpx 0;
  box-sizing: border-box;
  background: #f6f6f6;
}

.avatar-sec {
  display: flex;
  justify-content: center;
  padding: 40rpx 0 48rpx;
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.avatar-tip {
  font-size: 26rpx;
  color: #8c8c8c;
}

.bind-wrap {
  padding: 32rpx 24rpx 0;
}

.bind-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.save-wrap {
  padding: 48rpx 24rpx 0;
}

.form-skeleton {
  padding: 24rpx;
}
