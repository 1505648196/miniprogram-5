/* pages/news/news.wxss */
.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding: 16rpx;
  box-sizing: border-box;
}

.state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.news-list {
  padding-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 左图右文卡片 */
.news-card {
  display: flex;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.news-card--hover {
  background: #FAFAFA;
}

.news-img {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F0F0F0;
}

.news-card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.news-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-summary {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: auto;
}

.news-source {
  font-size: 20rpx;
  color: #999999;
}

.news-time {
  margin-left: auto;
  font-size: 22rpx;
  color: #BBBBBB;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
}

.load-more-text {
  font-size: 22rpx;
  color: #BBBBBB;
}
