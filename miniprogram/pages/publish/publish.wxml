<!-- pages/publish/publish.wxml 招工发布表单 -->
<view class="page">

  <!-- 1. 师傅类型（单选，默认折叠一半） -->
  <view class="card">
    <view class="card-title">师傅类型 <text class="required">*</text></view>
    <view class="role-grid">
      <view
        class="role-item {{roleIndex === item.i ? 'role-active' : ''}}"
        wx:for="{{visibleRoles}}"
        wx:key="i"
        data-index="{{item.i}}"
        bindtap="onRoleTap"
      >{{item.name}}</view>
    </view>
    <view
      class="roles-more"
      wx:if="{{rolesCollapsed ? visibleRoles.length < roles.length : roles.length > roleHalf}}"
      bindtap="toggleRoles"
    >{{rolesCollapsed ? '展开全部（共 ' + roles.length + ' 种）▾' : '收起 ▴'}}</view>
  </view>

  <!-- 2. 工资（数字） -->
  <view class="card">
    <view class="card-title">工资（元/月）</view>
    <view class="salary-row">
      <input
        class="input salary-input"
        type="number"
        placeholder="如 6000"
        placeholder-class="ph"
        value="{{salary}}"
        disabled="{{isFaceTalk}}"
        bindinput="onSalary"
      />
    </view>
    <view class="switch-row">
      <switch checked="{{isFaceTalk}}" color="#07c160" bindchange="onFaceTalk" />
      <text class="switch-label">薪资面议</text>
    </view>
  </view>

  <!-- 3. 选择区域（省市区） -->
  <view class="card">
    <view class="card-title">选择区域 <text class="required">*</text></view>
    <picker mode="region" value="{{region}}" bindchange="onRegionChange">
      <view class="picker {{regionText ? '' : 'picker-empty'}}">
        {{regionText || '点击选择省 / 市 / 区'}}
        <text class="picker-arrow">›</text>
      </view>
    </picker>
  </view>

  <!-- 4. 详细地址（定位获取） -->
  <view class="card">
    <view class="card-title">详细地址</view>
    <view class="locate-row">
      <input
        class="input locate-input"
        placeholder="店铺详细地址（xx路xx号）"
        placeholder-class="ph"
        value="{{address}}"
        bindinput="onAddress"
      />
      <view class="locate-btn {{locating ? 'locate-btn-disabled' : ''}}" bindtap="onLocate">
        {{locating ? '定位中...' : '📍 定位获取'}}
      </view>
    </view>
    <view class="locate-hint">点击"定位获取"可在地图上选点，自动填入地址和坐标</view>
  </view>

  <!-- 5. 具体描述 -->
  <view class="card">
    <view class="card-title">具体描述</view>
    <textarea
      class="textarea"
      placeholder="如：招大师傅，会做小笼包、生煎，管吃住，店里环境好…"
      placeholder-class="ph"
      maxlength="500"
      value="{{desc}}"
      bindinput="onDesc"
    />
  </view>

  <!-- 6. 电话 -->
  <view class="card">
    <view class="card-title">联系电话 <text class="required">*</text></view>
    <input
      class="input"
      type="number"
      maxlength="11"
      placeholder="11 位手机号"
      placeholder-class="ph"
      value="{{phone}}"
      bindinput="onPhone"
    />
  </view>

  <!-- 7. 联系人 -->
  <view class="card">
    <view class="card-title">联系人</view>
    <input
      class="input"
      placeholder="如：张老板"
      placeholder-class="ph"
      value="{{contact}}"
      bindinput="onContact"
    />
  </view>

  <!-- 8. 福利待遇（选填，默认折叠，点击展开三组） -->
  <view class="card tags-card">
    <view class="tags-head" bindtap="toggleTagsOpen">
      <view class="tags-head-left">
        <text class="card-title tags-title">🏷️ 福利待遇</text>
        <text class="optional">（选填）</text>
        <text class="tags-count" wx:if="{{tagCount}}">已选 {{tagCount}} 个</text>
      </view>
      <text class="tags-arrow">{{tagsOpen ? '收起 ▲' : '展开 ▼'}}</text>
    </view>

    <block wx:if="{{tagsOpen}}">
      <view class="tag-group">
        <view class="tag-group-title">福利待遇</view>
        <view class="tag-grid">
          <view
            class="tag-item welfare-tag {{welfareActiveMap[item] ? 'tag-active' : ''}}"
            wx:for="{{welfareOptions}}"
            wx:key="*this"
            data-group="welfare"
            data-index="{{index}}"
            bindtap="onTagTap"
          >{{item}}</view>
        </view>
      </view>
      <view class="tag-group">
        <view class="tag-group-title">老板籍贯</view>
        <view class="tag-grid">
          <view
            class="tag-item boss-tag {{bossRegionActiveMap[item] ? 'tag-active' : ''}}"
            wx:for="{{bossRegionOptions}}"
            wx:key="*this"
            data-group="bossRegion"
            data-index="{{index}}"
            bindtap="onTagTap"
          >{{item}}</view>
        </view>
      </view>
      <view class="tag-group">
        <view class="tag-group-title">工作类型</view>
        <view class="tag-grid">
          <view
            class="tag-item shop-tag {{shopTypeActiveMap[item] ? 'tag-active' : ''}}"
            wx:for="{{shopTypeOptions}}"
            wx:key="*this"
            data-group="shopType"
            data-index="{{index}}"
            bindtap="onTagTap"
          >{{item}}</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 提交 -->
  <view class="submit-bar">
    <view class="submit-btn {{submitting ? 'submit-btn-disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '发布中...' : '发布招工信息'}}
    </view>
  </view>
  <view class="safe-area"></view>

</view>
