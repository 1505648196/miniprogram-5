/* pages/publish/publish.wxss */
page {
  background: #f5f5f7;
}

.page {
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.required {
  color: #fa5151;
  font-weight: 400;
}

/* 师傅类型 */
.role-grid {
  display: flex;
  flex-wrap: wrap;
}

.role-item {
  padding: 14rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  background: #f5f5f7;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
  border: 2rpx solid transparent;
}

.role-active {
  background: #e8f8ef;
  color: #07c160;
  border-color: #07c160;
}

/* 师傅类型展开/收起按钮 */
.roles-more {
  margin-top: 8rpx;
  padding: 14rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #07c160;
  background: #f7fbf8;
  border-radius: 12rpx;
}

.roles-more:active {
  opacity: 0.7;
}

/* 标签卡：头部（折叠/展开） */
.tags-card {
  padding-top: 24rpx;
  padding-bottom: 20rpx;
}

.tags-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tags-head-left {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.tags-title {
  margin-bottom: 0;
}

.tags-count {
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  background: #e6f5ff;
  color: #10aeff;
  font-size: 22rpx;
  border-radius: 18rpx;
}

.tags-arrow {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 0 8rpx 24rpx;
}

/* 三组标签（福利/老板/店铺类型）：未选浅色描边 + 选中实心填色 */
.tag-group {
  margin-top: 18rpx;
}

.tag-group-title {
  font-size: 23rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
}

.tag-item {
  padding: 8rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  background: #f5f5f7;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #555;
  border: 2rpx solid #e5e5ea;
  line-height: 1.4;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.welfare-tag.tag-active {
  background: #e6f5ff;
  color: #10aeff;
  border-color: #10aeff;
}

.boss-tag.tag-active {
  background: #fff0e8;
  color: #e8541e;
  border-color: #e8541e;
}

.shop-tag.tag-active {
  background: #f3e8ff;
  color: #a259ff;
  border-color: #a259ff;
}

.tag-item:active {
  opacity: 0.7;
}

.optional {
  font-size: 24rpx;
  color: #8a8a8e;
  font-weight: 400;
  margin-left: 8rpx;
}

/* 工资 */
.salary-row {
  display: flex;
  align-items: center;
}

.salary-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.salary-sep {
  margin: 0 20rpx;
  color: #999;
}

.switch-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.switch-label {
  font-size: 26rpx;
  color: #666;
  margin-left: 8rpx;
}

/* 区域 */
.picker {
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-empty {
  color: #b0b0b0;
}

.picker-arrow {
  color: #999;
  font-size: 32rpx;
}

/* 定位 */
.locate-row {
  display: flex;
  align-items: center;
}

.locate-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.locate-btn {
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.locate-btn-disabled {
  background: #9fe3bd;
}

.locate-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}

/* 通用输入 */
.input {
  height: 80rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.ph {
  color: #b0b0b0;
}

.textarea {
  width: 100%;
  height: 180rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 提交 */
.submit-bar {
  margin-top: 32rpx;
}

.submit-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
}

.submit-btn-disabled {
  background: #9fe3bd;
}

.submit-btn:active {
  opacity: 0.85;
}

.safe-area {
  height: env(safe-area-inset-bottom);
}

/* ============ 发布成功弹层 ============ */
.pub-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.pub-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 56rpx 40rpx 40rpx;
  z-index: 210;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.16);
  text-align: center;
}

.pub-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto;
  background: #e8f8ef;
  color: #07c160;
  font-size: 64rpx;
  border-radius: 50%;
}

.pub-title {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.pub-sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #8a8a8e;
}

.pub-summary {
  margin-top: 28rpx;
  background: #f8f8fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.pub-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.pub-label {
  color: #8a8a8e;
}

.pub-value {
  color: #1a1a1a;
  font-weight: 600;
}

.pub-btns {
  margin-top: 36rpx;
  display: flex;
}

.pub-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.pub-btn-primary {
  background: #07c160;
  color: #fff;
  margin-right: 20rpx;
}

.pub-btn-ghost {
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.pub-btn:active {
  opacity: 0.85;
}
