/* pages/myposts/myposts.wxss */
.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.list-skeleton {
  padding: 8rpx 0;
}

.empty-wrap {
  padding: 120rpx 0;
}

/* 列表卡片 */
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.card-main {
  padding: 20rpx 24rpx 16rpx;
}
.card-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.card-type {
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}
.card-title {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-price {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #FF7A45;
}
.card-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

/* 操作栏 */
.card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #F0F0F0;
  background: #FAFAFA;
}
