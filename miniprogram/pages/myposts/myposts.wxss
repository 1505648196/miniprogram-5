/* pages/myposts/myposts.wxss */
.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 空态：撑满全屏让底部 tabbar 视觉贴底 */
.empty-wrap {
  min-height: calc(100vh - 200rpx);
}

.list-skeleton {
  padding: 8rpx 0;
}

/* 底部 TabBar 选中色：与 demo 一致（品牌橙 #FF7A45） */
.myposts-tabbar {
  --td-tab-bar-height: 96rpx;
  --td-tab-bar-color: #666666;
  --td-tab-bar-active-color: #FF7A45;
  --td-tab-bar-font: 20rpx;
}

.empty-wrap {
  padding: 120rpx 0;
}

/* 列表卡片 */
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 顶部发布信息按钮 */
.publish-bar {
  padding: 4rpx 0;
}
.publish-bar-btn {
  --td-button-primary-bg-color: #FF7A45;
  --td-button-primary-border-color: #FF7A45;
}
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.card-main {
  padding: 20rpx 24rpx 16rpx;
}
.card-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.card-type {
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}
.card-title {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-price {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #FF7A45;
}
.card-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

/* 下架状态标记 */
.card-status {
  padding: 0 24rpx 8rpx;
}

/* 发布类型选择弹层（同 demo 弹层样式） */
.pub-sheet {
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 16rpx calc(32rpx + env(safe-area-inset-bottom));
}
.pub-sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  text-align: center;
  margin-bottom: 24rpx;
}
.pub-grid {
  --td-grid-item-padding: 20rpx 0;
}
/* 发布类型图标容器：浅色圆角底 + 该类型主色 TDesign 图标（取代旧 emoji） */
.pub-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.pub-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #1A1A1A;
}

/* 操作栏 */
.card-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #F0F0F0;
  background: #FAFAFA;
}

/* ===== 手机号绑定居中弹窗 ===== */
.bind-sheet {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 44rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 560rpx;
  box-sizing: border-box;
}
.bind-sheet-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #FFF3EC;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.bind-sheet-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1A1A;
  text-align: center;
  line-height: 1.4;
}
.bind-sheet-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
}
.bind-sheet-btn {
  margin-top: 40rpx;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #FF7A45;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
}
.bind-sheet-btn::after {
  border: none;
}
.bind-sheet-cancel {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: #999999;
  padding: 12rpx 0;
}
