/* pages/publish_carpool/publish_carpool.wxss */
.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.sec {
  background: #FFFFFF;
  margin: 16rpx 16rpx 0;
  border-radius: 20rpx;
  padding: 8rpx 24rpx 24rpx;
}
.sec-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
  padding: 20rpx 0 8rpx;
}
.sec:first-child {
  margin-top: 16rpx;
}

/* 类别：车找人/人找车 单选卡片 */
.cat-list {
  display: flex;
  gap: 20rpx;
  padding-top: 12rpx;
}
.cat-item {
  flex: 1;
  border: 2rpx solid #E8E8E8;
  border-radius: 16rpx;
  background: #FAFAFA;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.cat-item.is-on {
  border-color: #597EF7;
  background: #F0F5FF;
}
.cat-emoji {
  font-size: 44rpx;
  line-height: 1;
}
.cat-name {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.cat-item.is-on .cat-name {
  color: #597EF7;
}
.cat-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #999999;
}

.cell-val {
  color: #1A1A1A;
}
.cell-ph {
  color: #b6b6b6;
}

.desc-box {
  margin-top: 8rpx;
}

.upload-box {
  margin-top: 8rpx;
}
.upload-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #F7F7F7;
  border: 2rpx dashed #D9D9D9;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}
.upload-add-txt {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
}
.upload-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #B6B6B6;
}

.submit-bar {
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.submit-bar .t-button {
  --td-button-primary-bg-color: #FFE60A;
  --td-button-primary-border-color: #FFE60A;
  --td-button-primary-color: #1A1A1A;
  --td-button-primary-active-bg-color: #F5D800;
  --td-button-primary-active-border-color: #F5D800;
  --td-button-font-size: 32rpx;
}
.submit-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: #999999;
}
