/* pages/privacy/privacy.wxss */
page {
  background: #F6F6F6;
}

.page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ============ 页头 ============ */
.doc-head {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 20rpx;
}
.doc-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.3;
}
.doc-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

/* ============ 正文 ============ */
.doc-body {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 32rpx 32rpx;
}
.sec {
  margin-top: 36rpx;
}
.sec-h {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.5;
  margin-bottom: 16rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #FFE60A;
}
.sec-p {
  font-size: 28rpx;
  color: #4A4A4A;
  line-height: 1.85;
  margin-bottom: 16rpx;
  /* 正文可选中复制，便于用户留存 */
  user-select: text;
}

/* 无损列表 */
.sec-list {
  margin-top: 8rpx;
}
.sec-li {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 16rpx;
}
.sec-li-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FFE60A;
  /* 与首行文字视觉居中 */
  margin-top: 20rpx;
}
.sec-li-text {
  flex: 1;
  font-size: 27rpx;
  color: #4A4A4A;
  line-height: 1.8;
  user-select: text;
}

/* ============ 页脚 ============ */
.doc-foot {
  margin-top: 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
}
.foot-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}
.foot-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
}
.foot-text {
  font-size: 28rpx;
  color: #1A1A1A;
}
.foot-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #BBBBBB;
}

.doc-end {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #BBBBBB;
}
