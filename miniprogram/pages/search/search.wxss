/* pages/search/search.wxss */
.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}
.sbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #FFE60A;
  padding: 12rpx 24rpx;
  box-sizing: border-box;
}
.s-input {
  --td-search-bg-color: #FFFFFF;
  --td-search-height: 72rpx;
  --td-search-font: 28rpx;
  --td-search-icon-color: #1A1A1A;
}

.feed-skeleton {
  padding: 32rpx 24rpx 0;
}
.goods-empty {
  padding: 120rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999999;
}

.goods {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 16rpx 32rpx;
  background: #F6F6F6;
}
.goods-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}
.goods-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.goods-img {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.goods-pic {
  width: 100%;
  display: block;
}
.goods-type {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.4;
  max-width: 70%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.goods-title {
  font-size: 26rpx;
  color: #1A1A1A;
  line-height: 1.4;
  padding: 16rpx 16rpx 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 12rpx 16rpx 0;
}
.goods-tag {
  --td-tag-font-size: 20rpx;
  --td-tag-height: 40rpx;
}
.goods-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999999;
  padding: 8rpx 16rpx 0;
  white-space: nowrap;
  overflow: hidden;
}
.goods-meta-type {
  flex-shrink: 0;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  max-width: 40%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.goods-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 16rpx 16rpx;
  gap: 8rpx;
}
.goods-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF7A45;
  line-height: 1.2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.goods-arrow {
  font-size: 20rpx;
  color: #999999;
  flex-shrink: 0;
}
.feed-footer {
  padding: 16rpx 0 40rpx;
  display: flex;
  justify-content: center;
}
.feed-end-text {
  font-size: 22rpx;
  color: #cccccc;
}
