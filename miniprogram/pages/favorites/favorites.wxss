/* pages/favorites/favorites.wxss */
.page {
  min-height: 100vh;
  background: #F6F6F6;
  box-sizing: border-box;
}
.list-skeleton { padding: 24rpx; }
.empty-wrap { padding: 140rpx 0; }

.goods {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 16rpx 32rpx;
}
.goods-col { flex: 1; display: flex; flex-direction: column; gap: 16rpx; min-width: 0; }
.goods-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.card-body { display: block; }
.goods-img { position: relative; width: 100%; display: flex; align-items: center; justify-content: center; }
.goods-pic { width: 100%; display: block; }
.goods-type {
  position: absolute; top: 12rpx; left: 12rpx; color: #FFFFFF; font-size: 20rpx;
  padding: 4rpx 14rpx; border-radius: 999rpx; line-height: 1.4;
}
.goods-title {
  font-size: 26rpx; color: #1A1A1A; line-height: 1.4; padding: 16rpx 16rpx 0;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.goods-meta { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: #999999; padding: 10rpx 16rpx 0; white-space: nowrap; overflow: hidden; }
.goods-meta-type {
  flex-shrink: 0; color: #FFFFFF; font-size: 20rpx; line-height: 1; padding: 4rpx 12rpx; border-radius: 999rpx;
}
.goods-price { font-size: 28rpx; font-weight: 700; color: #FF7A45; padding: 8rpx 16rpx 12rpx; }

.fav-cancel {
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
  padding: 12rpx 16rpx; border-top: 1rpx solid #F5F5F5; background: #FAFAFA;
  font-size: 22rpx; color: #999999;
}

.fav-footer { padding: 16rpx 0 40rpx; display: flex; justify-content: center; }
.fav-end { font-size: 22rpx; color: #cccccc; }
