<!-- pages/equip/equip.wxml -->
<!-- 包子行业信息平台 · 二手设备频道页 —— TDesign(tdesign-miniprogram) -->
<wxs src="./contain.wxs" module="tc" />
<view class="page">

  <!-- 模块 1:黄色 Header（与 demo 首页一致：Logo + 圆角搜索，无发布按钮） -->
  <view class="header">
    <view class="header-logo">包子一哥</view>
    <t-search
      class="hdr-search"
      shape="round"
      placeholder="搜索 设备/品牌/城市…"
      clearable="{{true}}"
      bind:change="onSearch"
    />
  </view>

  <!-- 模块 2:筛选条(成色 / 区域 / 价格) · t-sticky 吸顶 -->
  <t-sticky
    offset-top="{{stickyTop}}"
    z-index="{{20000}}"
    bind:scroll="onStickyScroll"
  >
    <t-dropdown-menu
      id="topDropdownMenu"
      class="top-dropdown {{tabsSticky ? 'is-sticky' : ''}} {{condPick && condPick !== '0' ? 'has-cond' : ''}} {{regionPick ? 'has-region' : ''}} {{price ? 'has-price' : ''}}"
      show-overlay="{{false}}"
    >
      <!-- 几成新:下拉面板内嵌单选列表 -->
      <t-dropdown-item id="condDropdownItem" label="{{condLabel}}">
        <view class="drop-sub">
          <view class="drop-sub-title">选择成色（至少达到）</view>
          <view class="drop-sub-list">
            <view
              wx:for="{{condOptions}}" wx:key="value"
              data-value="{{item.value}}"
              class="drop-sub-row {{condPick == item.value ? 'is-on' : ''}}"
              bind:tap="onCondRowTap"
            >
              <text class="drop-sub-row-label">{{item.label}}</text>
              <text wx:if="{{condPick == item.value}}" class="drop-sub-row-tick">✓</text>
            </view>
          </view>
        </view>
      </t-dropdown-item>

      <!-- 区域:下拉内常用城市 + t-cascader -->
      <t-dropdown-item id="regionDropdownItem" label="{{regionPick || '区域'}}" bind:open="onRegionDropdownOpen">
        <view class="drop-region">
          <view class="drop-region-title">常用城市</view>
          <view class="drop-region-tags">
            <view
              wx:for="{{hotCities}}" wx:key="code"
              class="drop-city-wrap {{regionCode === item.code ? 'is-on' : ''}}"
              data-name="{{item.name}}"
              data-code="{{item.code}}"
              bind:tap="onHotCity"
            >
              <t-tag
                size="extra-large" variant="light"
                class="drop-city-tag {{regionCode === item.code ? 'is-on' : ''}}"
              >{{item.name}}</t-tag>
            </view>
          </view>
          <view class="drop-region-actions">
            <t-button
              class="drop-region-more"
              theme="primary"
              bind:tap="openCascader"
            >查看完整省市区</t-button>
            <t-button
              wx:if="{{regionPick}}"
              class="drop-region-reset"
              theme="default" variant="text"
              bind:tap="onRegionReset"
            >重置</t-button>
          </view>
        </view>
      </t-dropdown-item>

      <!-- 价格:下拉内输入最低售价/预算 -->
      <t-dropdown-item id="priceDropdownItem" label="{{priceLabel}}">
        <view class="drop-salary">
          <view class="drop-salary-row">
            <t-input
              key="price-{{priceInputKey}}"
              class="drop-salary-input"
              type="number" placeholder="最低价格"
              maxlength="7"
              value="{{price}}"
              bind:change="onPrice"
              bind:blur="onPriceBlur"
            />
            <text class="drop-salary-unit">元</text>
          </view>
          <view class="drop-salary-tip">填最低售价/预算，限数字，最高 500 万</view>
          <view class="drop-salary-actions">
            <t-button class="drop-salary-btn-reset" theme="default" variant="outline" bind:tap="onPriceClear">清空</t-button>
            <t-button class="drop-salary-btn-confirm" theme="primary" bind:tap="onPriceConfirm">确定</t-button>
          </view>
        </view>
      </t-dropdown-item>
    </t-dropdown-menu>
  </t-sticky>

  <!-- 模块 3:信息类别（出售/求购）双选卡片 -->
  <block wx:if="{{filterBarVisible}}">
    <view class="type-check">
      <t-checkbox-group
        class="type-check-list"
        value="{{selectedTypes}}"
        bind:change="onTypeChange"
      >
        <view
          wx:for="{{typeCards}}" wx:key="value"
          class="type-check-item {{tc.contain(selectedTypes, item.value) ? 'is-on' : ''}}"
        >
          <t-icon
            wx:if="{{tc.contain(selectedTypes, item.value)}}"
            name="check"
            t-class="type-check-check"
            ariaHidden="{{true}}"
          />
          <t-checkbox value="{{item.value}}" icon="none" borderless>
            <view class="type-check-label">
              <view class="type-check-name">{{item.label}}</view>
              <view class="type-check-desc">{{item.desc}}</view>
            </view>
          </t-checkbox>
        </view>
      </t-checkbox-group>
    </view>
  </block>

  <!-- 模块 4:设备信息双列瀑布流 -->
  <view class="feed">
    <t-skeleton
      wx:if="{{loading}}"
      class="feed-skeleton"
      theme="paragraph"
      animation="gradient"
      row-col="{{skeletonRows}}"
    />
    <view class="goods-empty" wx:elif="{{!goodsLeft.length && !goodsRight.length}}">
      <t-empty icon="search" description="{{emptyText}}" />
    </view>

    <view class="goods" wx:else>
      <view class="goods-col">
        <view class="goods-card {{item.isTop ? 'goods-card-top' : ''}}"
              wx:for="{{goodsLeft}}" wx:key="id"
              data-id="{{item.id}}" bindtap="onTap">
          <view class="goods-img" wx:if="{{item.image}}" style="background: {{item.light}};">
            <image class="goods-pic" src="{{item.image}}" mode="widthFix" />
            <view class="goods-badges">
              <image wx:if="{{item.isTop}}" class="goods-top-img" src="/static/badge-top.png" mode="heightFix" />
              <text class="goods-badge" style="background: {{item.color}};">{{item.typeName}}</text>
            </view>
          </view>
          <view class="goods-badges goods-badges-top" wx:else>
            <image wx:if="{{item.isTop}}" class="goods-top-img" src="/static/badge-top-nopic.png" mode="heightFix" />
            <text class="goods-badge" style="background: {{item.color}};">{{item.typeName}}</text>
          </view>
          <view class="goods-title">{{item.title}}</view>
          <view class="goods-tags" wx:if="{{item.tags.length}}">
            <t-tag wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this" size="small" variant="light" t-class="goods-tag">{{tg}}</t-tag>
          </view>
          <view class="goods-user" wx:if="{{item.username}}">
            <t-icon name="user" size="24rpx" color="#FFE60A" />
            <text>{{item.username}}</text>
            <text class="goods-credit" wx:if="{{item.creditMeta}}" style="color: {{item.creditMeta.color}}; background: {{item.creditMeta.bg}};">{{item.creditMeta.label}}</text>
          </view>
          <view class="goods-meta">
            <text>{{item.meta}}</text>
          </view>
          <view class="goods-price-row">
            <view class="goods-price">{{item.priceText}}</view>
            <view class="goods-arrow">查看 ›</view>
          </view>
        </view>
      </view>
      <view class="goods-col">
        <view class="goods-card {{item.isTop ? 'goods-card-top' : ''}}"
              wx:for="{{goodsRight}}" wx:key="id"
              data-id="{{item.id}}" bindtap="onTap">
          <view class="goods-img" wx:if="{{item.image}}" style="background: {{item.light}};">
            <image class="goods-pic" src="{{item.image}}" mode="widthFix" />
            <view class="goods-badges">
              <image wx:if="{{item.isTop}}" class="goods-top-img" src="/static/badge-top.png" mode="heightFix" />
              <text class="goods-badge" style="background: {{item.color}};">{{item.typeName}}</text>
            </view>
          </view>
          <view class="goods-badges goods-badges-top" wx:else>
            <image wx:if="{{item.isTop}}" class="goods-top-img" src="/static/badge-top-nopic.png" mode="heightFix" />
            <text class="goods-badge" style="background: {{item.color}};">{{item.typeName}}</text>
          </view>
          <view class="goods-title">{{item.title}}</view>
          <view class="goods-tags" wx:if="{{item.tags.length}}">
            <t-tag wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this" size="small" variant="light" t-class="goods-tag">{{tg}}</t-tag>
          </view>
          <view class="goods-user" wx:if="{{item.username}}">
            <t-icon name="user" size="24rpx" color="#FFE60A" />
            <text>{{item.username}}</text>
            <text class="goods-credit" wx:if="{{item.creditMeta}}" style="color: {{item.creditMeta.color}}; background: {{item.creditMeta.bg}};">{{item.creditMeta.label}}</text>
          </view>
          <view class="goods-meta">
            <text>{{item.meta}}</text>
          </view>
          <view class="goods-price-row">
            <view class="goods-price">{{item.priceText}}</view>
            <view class="goods-arrow">查看 ›</view>
          </view>
        </view>
      </view>
    </view>

    <view class="feed-footer">
      <t-loading wx:if="{{loadingMore}}" theme="circular" size="32rpx" text="加载更多…" layout="vertical" />
      <text wx:elif="{{firstLoaded && !hasMore && !loading}}" class="feed-end-text">— 没有更多了 —</text>
    </view>
  </view>

  <!-- ========== 区域选择弹层(t-cascader) ========== -->
  <t-cascader
    visible="{{regionVisible}}"
    title="选择城市"
    options="{{regionOptions}}"
    theme="tab"
    filterable="{{true}}"
    filter-placeholder="搜索城市/区域"
    bind:change="onRegionChange"
    bind:pick="onRegionPick"
    bind:close="onRegionClose"
  />

  <!-- 底部导航 -->
  <comp-tabbar current="home" />

</view>
