/* pages/publish_recruit/publish_recruit.wxss */
.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.sec {
  background: #FFFFFF;
  margin: 16rpx 16rpx 0;
  border-radius: 20rpx;
  padding: 8rpx 24rpx 24rpx;
}
.sec-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
  padding: 20rpx 0 8rpx;
}
.sec:first-child {
  margin-top: 16rpx;
}

/* 师傅类型网格 */
.sub-grid {
  --td-grid-item-padding: 10rpx 0;
}
.sub-item {
  width: 100%;
  text-align: center;
  font-size: 24rpx;
  color: #1A1A1A;
  padding: 14rpx 0;
  border-radius: 12rpx;
  background: #F5F5F5;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.sub-item.is-on {
  background: #FFF1E8;
  color: #FF7A45;
  border-color: #FF7A45;
  font-weight: 600;
}

/* ============ 6. 置顶推广（付费增值） ============ */
/* 整块浅黄渐变底，与普通表单区块（白底）形成「增值服务」的视觉区分 */
.top-sec {
  background: linear-gradient(180deg, #FFFBF0 0%, #FFF7E6 100%);
  border: 2rpx solid #FFE7B8;
}

.top-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 0 12rpx;
}
.top-head-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #B26A00;
}
.top-head-sub {
  font-size: 24rpx;
  color: #C99A4E;
}
.top-intro {
  font-size: 24rpx;
  color: #A67C3D;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

/* 套餐卡：白底 + 圆角，选中态黄框 + 浅黄底 */
.top-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border: 3rpx solid #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(180, 130, 30, 0.06);
  transition: all 0.18s ease;
}
.top-card.is-on {
  border-color: #FFD666;
  background: #FFFDF5;
  box-shadow: 0 4rpx 16rpx rgba(255, 190, 60, 0.22);
}

/* 左侧选择圆点 */
.top-radio {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #E0E0E0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.top-radio.is-on {
  background: #FFC53D;
  border-color: #FFC53D;
}

.top-body {
  flex: 1;
  min-width: 0;
}
.top-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.top-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}
/* 推荐标签 */
.top-tag {
  font-size: 20rpx;
  line-height: 1;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF7A45 0%, #FF4D4F 100%);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}
.top-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #999999;
  line-height: 1.4;
}

/* 价格：现价加粗 + 原价划线 */
.top-price-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.top-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #E8A33D;
  line-height: 1;
}
.top-origin {
  font-size: 22rpx;
  color: #C4C4C4;
  text-decoration: line-through;
}

/* 暂不开通（默认态） */
.top-skip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx;
}
.top-skip-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #EDEDED;
  color: #999999;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}
.top-skip.is-on .top-skip-icon {
  background: #D9D9D9;
  color: #666666;
}
.top-skip-text {
  font-size: 26rpx;
  color: #999999;
}
.top-skip.is-on .top-skip-text {
  color: #666666;
}

/* 已选提示 */
.top-tip {
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  background: #FFF7E6;
  border-radius: 12rpx;
  font-size: 23rpx;
  color: #B26A00;
  line-height: 1.5;
}

.cell-val {
  color: #1A1A1A;
}
.cell-ph {
  color: #b6b6b6;
}

.desc-box {
  margin-top: 8rpx;
}

/* 图片上传：自定义"添加图片"占位块（t-upload 的 addContent 槽） */
.upload-box {
  margin-top: 8rpx;
}
.upload-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #F7F7F7;
  border: 2rpx dashed #D9D9D9;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}
.upload-add-txt {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
}
.upload-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #B6B6B6;
}

/* 提交 */
.submit-bar {
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.submit-bar .fill-btn {
  margin-bottom: 20rpx;
}
.submit-bar .t-button {
  --td-button-primary-bg-color: #FFE60A;
  --td-button-primary-border-color: #FFE60A;
  --td-button-primary-color: #1A1A1A;
  --td-button-primary-active-bg-color: #F5D800;
  --td-button-primary-active-border-color: #F5D800;
  --td-button-font-size: 32rpx;
}
.submit-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: #999999;
}

/* 发布后推荐弹窗（居中卡片） */
.recommend-sheet {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 28rpx 28rpx;
  width: 620rpx;
  max-height: 72vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.recommend-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.recommend-head-txt {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.recommend-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.4;
}
.recommend-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #FF7A45;
}
.recommend-close {
  padding: 4rpx 0 0 16rpx;
}
.recommend-scroll {
  flex: 1;
  max-height: 56vh;
}
.recommend-item {
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #FAFAFA;
  margin-bottom: 16rpx;
}
.recommend-item:last-child {
  margin-bottom: 0;
}
.recommend-item-main {
  display: flex;
  flex-direction: column;
}
.recommend-item-title {
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.45;
  font-weight: 600;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.recommend-item-tags {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.recommend-tag {
  font-size: 22rpx;
  line-height: 1;
  color: #666666;
  background: #F0F0F0;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
}
.recommend-tag--loc {
  color: #4C7BF4;
  background: #EEF3FF;
}
.recommend-tag--price {
  color: #FF7A45;
  background: #FFF1E8;
  font-weight: 600;
}
/* 拨打电话行：脱敏号 + 按钮 */
.recommend-item-call {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.recommend-phone {
  font-size: 26rpx;
  color: #666666;
  letter-spacing: 1rpx;
}
.recommend-call-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #FF7A45;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  line-height: 1;
}
.recommend-call-btn:active {
  background: #F2662E;
}
/* 加载态：置灰 + 禁用点击，避免支付过程中重复触发 */
.recommend-call-btn.is-loading {
  background: #C9C9C9;
  color: #F5F5F5;
  pointer-events: none;
}
.recommend-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}
