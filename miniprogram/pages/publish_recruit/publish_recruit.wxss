/* pages/publish_recruit/publish_recruit.wxss */
.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.sec {
  background: #FFFFFF;
  margin: 16rpx 16rpx 0;
  border-radius: 20rpx;
  padding: 8rpx 24rpx 24rpx;
}
.sec-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
  padding: 20rpx 0 8rpx;
}
.sec:first-child {
  margin-top: 16rpx;
}

/* 师傅类型网格 */
.sub-grid {
  --td-grid-item-padding: 10rpx 0;
}
.sub-item {
  width: 100%;
  text-align: center;
  font-size: 24rpx;
  color: #1A1A1A;
  padding: 14rpx 0;
  border-radius: 12rpx;
  background: #F5F5F5;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.sub-item.is-on {
  background: #FFF1E8;
  color: #FF7A45;
  border-color: #FF7A45;
  font-weight: 600;
}

/* 置顶推广网格 */
.top-grid {
  --td-grid-item-padding: 10rpx 0;
}
.top-item {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 0;
  border-radius: 12rpx;
  background: #F5F5F5;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.top-item-days {
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 600;
}
.top-item-price {
  font-size: 20rpx;
  color: #999999;
}
.top-item.is-on {
  background: #FFF1E8;
  border-color: #FF7A45;
}
.top-item.is-on .top-item-days {
  color: #FF7A45;
}
.top-item.is-on .top-item-price {
  color: #FF7A45;
}

.cell-val {
  color: #1A1A1A;
}
.cell-ph {
  color: #b6b6b6;
}

.desc-box {
  margin-top: 8rpx;
}

/* 图片上传：自定义"添加图片"占位块（t-upload 的 addContent 槽） */
.upload-box {
  margin-top: 8rpx;
}
.upload-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #F7F7F7;
  border: 2rpx dashed #D9D9D9;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}
.upload-add-txt {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
}
.upload-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #B6B6B6;
}

/* 提交 */
.submit-bar {
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.submit-bar .fill-btn {
  margin-bottom: 20rpx;
}
.submit-bar .t-button {
  --td-button-primary-bg-color: #FFE60A;
  --td-button-primary-border-color: #FFE60A;
  --td-button-primary-color: #1A1A1A;
  --td-button-primary-active-bg-color: #F5D800;
  --td-button-primary-active-border-color: #F5D800;
  --td-button-font-size: 32rpx;
}
.submit-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: #999999;
}

/* 发布后推荐弹窗（居中卡片） */
.recommend-sheet {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 28rpx 28rpx;
  width: 620rpx;
  max-height: 72vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.recommend-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.recommend-head-txt {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.recommend-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.4;
}
.recommend-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #FF7A45;
}
.recommend-close {
  padding: 4rpx 0 0 16rpx;
}
.recommend-scroll {
  flex: 1;
  max-height: 56vh;
}
.recommend-item {
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #FAFAFA;
  margin-bottom: 16rpx;
}
.recommend-item:last-child {
  margin-bottom: 0;
}
.recommend-item-main {
  display: flex;
  flex-direction: column;
}
.recommend-item-title {
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.45;
  font-weight: 600;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.recommend-item-tags {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.recommend-tag {
  font-size: 22rpx;
  line-height: 1;
  color: #666666;
  background: #F0F0F0;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
}
.recommend-tag--loc {
  color: #4C7BF4;
  background: #EEF3FF;
}
.recommend-tag--price {
  color: #FF7A45;
  background: #FFF1E8;
  font-weight: 600;
}
/* 拨打电话行：脱敏号 + 按钮 */
.recommend-item-call {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.recommend-phone {
  font-size: 26rpx;
  color: #666666;
  letter-spacing: 1rpx;
}
.recommend-call-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #FF7A45;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  line-height: 1;
}
.recommend-call-btn:active {
  background: #F2662E;
}
/* 加载态：置灰 + 禁用点击，避免支付过程中重复触发 */
.recommend-call-btn.is-loading {
  background: #C9C9C9;
  color: #F5F5F5;
  pointer-events: none;
}
.recommend-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}
