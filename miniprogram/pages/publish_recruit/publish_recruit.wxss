/* pages/publish_recruit/publish_recruit.wxss */
.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.sec {
  background: #FFFFFF;
  margin: 16rpx 16rpx 0;
  border-radius: 20rpx;
  padding: 8rpx 24rpx 24rpx;
}
.sec-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
  padding: 20rpx 0 8rpx;
}
.sec:first-child {
  margin-top: 16rpx;
}

/* 师傅类型网格 */
.sub-grid {
  --td-grid-item-padding: 10rpx 0;
}
.sub-item {
  width: 100%;
  text-align: center;
  font-size: 24rpx;
  color: #1A1A1A;
  padding: 14rpx 0;
  border-radius: 12rpx;
  background: #F5F5F5;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.sub-item.is-on {
  background: #FFF1E8;
  color: #FF7A45;
  border-color: #FF7A45;
  font-weight: 600;
}

.cell-val {
  color: #1A1A1A;
}
.cell-ph {
  color: #b6b6b6;
}

.desc-box {
  margin-top: 8rpx;
}

/* 图片上传：自定义"添加图片"占位块（t-upload 的 addContent 槽） */
.upload-box {
  margin-top: 8rpx;
}
.upload-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #F7F7F7;
  border: 2rpx dashed #D9D9D9;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}
.upload-add-txt {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
}
.upload-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #B6B6B6;
}

/* 提交 */
.submit-bar {
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.submit-bar .t-button {
  --td-button-primary-bg-color: #FFE60A;
  --td-button-primary-border-color: #FFE60A;
  --td-button-primary-color: #1A1A1A;
  --td-button-primary-active-bg-color: #F5D800;
  --td-button-primary-active-border-color: #F5D800;
  --td-button-font-size: 32rpx;
}
.submit-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: #999999;
}
