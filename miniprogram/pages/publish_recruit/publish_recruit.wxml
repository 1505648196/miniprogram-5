<!-- pages/publish_recruit/publish_recruit.wxml -->
<!-- 包子行业信息平台 · 发布招工 —— TDesign(tdesign-miniprogram) -->
<view class="page">

  <!-- 师傅类型：t-grid 单选 -->
  <view class="sec">
    <view class="sec-title">1. 招什么师傅</view>
    <t-grid class="sub-grid" column="{{4}}" hover>
      <t-grid-item
        wx:for="{{subOptions}}" wx:key="roleId"
        data-idx="{{index}}" bind:click="onSubTap"
      >
        <view class="sub-item {{subIdx === index ? 'is-on' : ''}}">{{item.name}}</view>
      </t-grid-item>
    </t-grid>
  </view>

  <!-- 基本信息 -->
  <view class="sec">
    <view class="sec-title">2. 基本待遇与地点</view>
    <t-cell-group theme="card">
      <t-input label="薪资" placeholder="如 8000（元/月），留空=面议" type="number"
        value="{{form.salary}}" data-field="salary" bind:change="onInput" />
      <t-cell title="所在地区" arrow hover bind:click="openRegion">
        <text slot="note" class="{{regionPick ? 'cell-val' : 'cell-ph'}}">{{regionPick || '请选择省市区'}}</text>
      </t-cell>
      <t-input label="详细地址" placeholder="街道/门店/楼栋（可空）"
        value="{{form.address}}" data-field="address" bind:change="onInput" />
    </t-cell-group>
  </view>

  <!-- 联系方式 -->
  <view class="sec">
    <view class="sec-title">3. 联系方式</view>
    <t-cell-group theme="card">
      <t-input label="手机号" placeholder="11 位手机号" type="number" maxlength="11"
        value="{{form.phone}}" data-field="phone" bind:change="onInput" />
      <t-input label="联系人" placeholder="如 王老板（可空）"
        value="{{form.contact}}" data-field="contact" bind:change="onInput" />
      <!-- 发布昵称已隐藏：改为后端自动填充/云端默认，不再让用户填 -->
    </t-cell-group>
  </view>

  <!-- 描述 -->
  <view class="sec">
    <view class="sec-title">4. 具体描述</view>
    <view class="desc-box">
      <t-textarea
        value="{{form.desc}}" data-field="desc" bind:change="onInput"
        placeholder="如：招大师傅，包吃住，月休4天，每天工作8小时，会做小笼包优先…"
        maxlength="500"
      />
    </view>
  </view>

  <!-- 图片(选填)：单张封面图，上传到云存储（放表单最下面、提交前） -->
  <view class="sec">
    <view class="sec-title">5. 图片（选填，最多 1 张）</view>
    <t-upload
      files="{{imageFiles}}"
      max="{{1}}"
      media-type="{{['image']}}"
      add-content="{{'slot'}}"
      grid-config="{{uploadGrid}}"
      bind:success="onUploadSuccess"
      bind:remove="onUploadRemove"
      t-class="upload-box"
    >
      <view slot="add-content" class="upload-add">＋<text class="upload-add-txt">添加图片</text></view>
    </t-upload>
    <view class="upload-tip">建议上传店铺环境 / 产品实拍，提升招聘效果</view>
  </view>

  <!-- 置顶推广（选填）：付费置顶 1/3/7 天 -->
  <view class="sec">
    <view class="sec-title">6. 置顶推广（选填，付费）</view>
    <t-grid class="top-grid" column="{{4}}" hover>
      <t-grid-item
        wx:for="{{topOptions}}" wx:key="days"
        data-days="{{item.days}}" bind:click="onTopTap"
      >
        <view class="top-item {{topDays === item.days ? 'is-on' : ''}}">
          <text class="top-item-days">{{item.label}}</text>
          <text class="top-item-price" wx:if="{{item.price > 0}}">{{item.priceText}}</text>
          <text class="top-item-price" wx:else>免费</text>
        </view>
      </t-grid-item>
    </t-grid>
    <view class="upload-tip" wx:if="{{topDays > 0}}">置顶 {{topDays}} 天，费用 {{topPriceText}}，支付成功后置顶生效</view>
  </view>

  <!-- 提交 -->
  <view class="submit-bar">
    <t-button theme="default" variant="outline" block="{{true}}" t-class="fill-btn" bind:tap="onFillTestData">
      一键填充测试数据
    </t-button>
    <t-button theme="primary" block="{{true}}" loading="{{submitting}}" bind:tap="onSubmit">
      {{topDays > 0 ? '确认发布并支付置顶' : '确认发布'}}
    </t-button>
    <view class="submit-tip">发布需经内容安全审核，违规信息将被拦截</view>
  </view>

  <!-- 省市区选择弹层 -->
  <t-cascader
    visible="{{regionVisible}}"
    title="选择省市区"
    options="{{regionOptions}}"
    theme="tab"
    filterable="{{true}}"
    filter-placeholder="搜索"
    bind:change="onRegionChange"
    bind:close="onRegionClose"
  />

  <!-- 发布后推荐弹窗（居中） -->
  <t-popup
    visible="{{recommendVisible}}"
    placement="center"
    bind:visible-change="onRecommendVisibleChange"
  >
    <view class="recommend-sheet">
      <!-- 头部：提示语 + 副标题 + 关闭 -->
      <view class="recommend-head">
        <view class="recommend-head-txt">
          <text class="recommend-title">{{recommendTitle}}</text>
          <text class="recommend-subtitle" wx:if="{{recommendSubtitle}}">{{recommendSubtitle}}</text>
        </view>
        <view class="recommend-close" bind:tap="onRecommendCloseTap">
          <t-icon name="close" size="40rpx" color="#999999" />
        </view>
      </view>

      <!-- 列表 -->
      <scroll-view class="recommend-scroll" scroll-y="{{true}}">
        <view
          class="recommend-item"
          wx:for="{{recommendList}}" wx:key="_id"
        >
          <view class="recommend-item-main" data-id="{{item._id}}" bind:tap="onRecommendTap">
            <text class="recommend-item-title">{{item.title || '无标题'}}</text>
            <view class="recommend-item-tags">
              <text class="recommend-tag" wx:if="{{item.role}}">{{item.role}}</text>
              <text class="recommend-tag recommend-tag--loc" wx:if="{{item.province || item.city}}">{{item.province}}{{item.city}}</text>
              <text class="recommend-tag recommend-tag--price" wx:if="{{item.salary > 0}}">{{item.salary}}元/月</text>
              <text class="recommend-tag recommend-tag--price" wx:elif="{{item.price > 0}}">{{item.price}}元</text>
            </view>
          </view>
          <view class="recommend-item-call">
            <text class="recommend-phone" wx:if="{{item.phone_masked}}">{{item.phone_masked}}</text>
            <view class="recommend-call-btn {{recommendCalling ? 'is-loading' : ''}}" data-id="{{item._id}}" catch:tap="onRecommendCall">{{recommendCalling ? '加载中…' : '拨打电话'}}</view>
          </view>
        </view>
        <view class="recommend-empty" wx:if="{{!recommendList.length}}">暂无匹配信息</view>
      </scroll-view>
    </view>
  </t-popup>

</view>
