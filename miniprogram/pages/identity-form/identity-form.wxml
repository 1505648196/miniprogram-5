<!-- pages/identity-form/identity-form.wxml -->
<!-- 身份认证表单页：按身份类型显示不同字段 -->
<view class="page">

  <!-- 加载骨架屏 -->
  <view wx:if="{{loading}}" class="skeleton">
    <t-skeleton theme="avatar" />
    <t-skeleton theme="text" />
    <t-skeleton theme="text" />
  </view>

  <block wx:else>
    <!-- 顶部：身份标识 -->
    <view class="type-header" style="background: {{fieldConfig[identityType].color}}10;">
      <t-icon name="{{fieldConfig[identityType].icon}}" size="64rpx" color="{{fieldConfig[identityType].color}}" />
      <view class="type-name">{{identityName}}认证</view>
      <view class="type-desc">请填写真实信息，人工审核通过后生效</view>
    </view>

    <!-- 审核状态提示 -->
    <view wx:if="{{applyStatus === 'pending'}}" class="status-banner status-pending">
      <t-icon name="time" size="36rpx" color="#FA8C16" />
      <text class="status-text">认证审核中，请耐心等待</text>
      <t-button size="small" theme="default" variant="outline" bindtap="onCancelTap">撤销申请</t-button>
    </view>
    <view wx:elif="{{applyStatus === 'rejected'}}" class="status-banner status-rejected">
      <t-icon name="close-circle" size="36rpx" color="#FF4D4F" />
      <text class="status-text">认证被驳回：{{rejectReason || '请修改后重新提交'}}</text>
    </view>
    <view wx:elif="{{applyStatus === 'approved'}}" class="status-banner status-approved">
      <t-icon name="check-circle" size="36rpx" color="#52C41A" />
      <text class="status-text">认证已通过</text>
    </view>

    <!-- 表单（所有状态都可编辑，approved 重新提交会覆盖） -->
    <view class="form" wx:if="{{applyStatus !== 'pending'}}">

      <!-- 师傅字段：姓名 + 身份证 + 电话 + 地址 -->
      <block wx:if="{{identityType === 'master'}}">
        <t-cell-group theme="card">
          <t-cell title="姓名" required>
            <input slot="note" class="cell-input" placeholder="请输入真实姓名" maxlength="20" value="{{form.real_name}}" bindinput="onNameInput" />
          </t-cell>
          <t-cell title="身份证号" required>
            <input slot="note" class="cell-input" placeholder="请输入身份证号" maxlength="18" value="{{form.id_card}}" bindinput="onIdCardInput" />
          </t-cell>
          <t-cell title="电话号码" required>
            <input slot="note" class="cell-input" type="number" placeholder="请输入 11 位手机号" maxlength="11" value="{{form.phone}}" bindinput="onPhoneInput" />
          </t-cell>
          <t-cell title="地址" required>
            <input slot="note" class="cell-input" placeholder="请输入常驻地址" maxlength="100" value="{{form.address}}" bindinput="onAddressInput" />
          </t-cell>
        </t-cell-group>
      </block>

      <!-- 店主字段：营业执照 + 身份证 + 电话 + 地址 -->
      <block wx:if="{{identityType === 'owner'}}">
        <!-- 营业执照 -->
        <view class="form-section">
          <view class="form-section-title">营业执照<text class="form-required">*</text></view>
          <view class="upload-row">
            <view class="upload-add" wx:if="{{!form.license_img}}" bindtap="onPickLicense">
              <t-icon name="image" size="64rpx" color="#999999" />
              <text class="upload-text">上传营业执照</text>
            </view>
            <view class="upload-add" wx:else>
              <image class="upload-pic" src="{{form.license_img}}" mode="aspectFill" data-item="{{form.license_img}}" bindtap="onPreviewPhoto" />
              <view class="upload-remove" catchtap="onRemoveLicense">×</view>
            </view>
          </view>
        </view>

        <t-cell-group theme="card">
          <t-cell title="姓名" required>
            <input slot="note" class="cell-input" placeholder="请输入真实姓名" maxlength="20" value="{{form.real_name}}" bindinput="onNameInput" />
          </t-cell>
          <t-cell title="身份证号" required>
            <input slot="note" class="cell-input" placeholder="请输入身份证号" maxlength="18" value="{{form.id_card}}" bindinput="onIdCardInput" />
          </t-cell>
          <t-cell title="电话号码" required>
            <input slot="note" class="cell-input" type="number" placeholder="请输入 11 位手机号" maxlength="11" value="{{form.phone}}" bindinput="onPhoneInput" />
          </t-cell>
          <t-cell title="店铺地址" required>
            <input slot="note" class="cell-input" placeholder="请输入店铺地址" maxlength="100" value="{{form.address}}" bindinput="onAddressInput" />
          </t-cell>
        </t-cell-group>
      </block>

      <!-- 其他证明材料（可选） -->
      <view class="form-section">
        <view class="form-section-title">其他证明材料<text class="form-section-tip">（可选，最多 6 张）</text></view>
        <view class="upload-row">
          <view class="upload-add" wx:for="{{form.photos}}" wx:key="*this" wx:for-item="ph">
            <image class="upload-pic" src="{{ph}}" mode="aspectFill" data-item="{{ph}}" bindtap="onPreviewPhoto" />
            <view class="upload-remove" data-index="{{index}}" catchtap="onRemovePhoto">×</view>
          </view>
          <view class="upload-add" wx:if="{{form.photos.length < 6}}" bindtap="onPickPhotos">
            <t-icon name="image" size="64rpx" color="#999999" />
          </view>
        </view>
      </view>

      <!-- 提交按钮 -->
      <view class="submit-wrap">
        <t-button theme="primary" size="large" block bindtap="onSubmit" loading="{{submitting}}">
          {{applyStatus === 'approved' ? '修改资料重新提交' : applyStatus === 'rejected' ? '重新提交认证' : '提交认证申请'}}
        </t-button>
      </view>
    </view>
  </block>

  <!-- 撤销确认弹窗 -->
  <t-dialog
    visible="{{cancelDialogVisible}}"
    title="撤销认证申请"
    content="确定撤销当前认证申请吗？撤销后可重新提交。"
    confirm-btn="{{ { content: '确定撤销', theme: 'danger' } }}"
    cancel-btn="取消"
    bind:confirm="onCancelConfirm"
    bind:cancel="onCancelDialogClose"
    bind:close="onCancelDialogClose"
  />

</view>
