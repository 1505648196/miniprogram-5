/* pages/identity-form/identity-form.wxss */
.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding-bottom: 32rpx;
  box-sizing: border-box;
}

/* ===== 骨架屏 ===== */
.skeleton {
  padding: 32rpx 24rpx;
}

/* ===== 顶部身份标识 ===== */
.type-header {
  padding: 40rpx 32rpx;
  text-align: center;
  border-radius: 0 0 32rpx 32rpx;
}
.type-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-top: 16rpx;
}
.type-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* ===== 审核状态条 ===== */
.status-banner {
  margin: 24rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.status-pending {
  background: #FFF7E6;
  border: 1rpx solid #FFD591;
}
.status-rejected {
  background: #FFF1F0;
  border: 1rpx solid #FFCCC7;
}
.status-approved {
  background: #F6FFED;
  border: 1rpx solid #B7EB8F;
}
.status-text {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A1A;
}

/* ===== 表单 ===== */
.form {
  margin-top: 24rpx;
}
.form-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
}
.form-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}
.form-required {
  color: #FF4D4F;
  margin-left: 4rpx;
}
.form-section-tip {
  font-size: 22rpx;
  color: #999999;
}

/* ===== 表单输入 ===== */
.cell-input {
  font-size: 28rpx;
  color: #1A1A1A;
  text-align: right;
  width: 100%;
}

/* ===== 图片上传 ===== */
.upload-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.upload-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #D9D9D9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  position: relative;
}
.upload-text {
  font-size: 20rpx;
  color: #999999;
}
.upload-pic {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}
.upload-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 32rpx;
  height: 32rpx;
  background: #FF4D4F;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 提交按钮 ===== */
.submit-wrap {
  margin: 32rpx 24rpx 0;
}

/* ===== 只读信息展示 ===== */
.readonly-info {
  margin-top: 24rpx;
}
.readonly-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
}
.readonly-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}
.readonly-pic {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}
.readonly-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
