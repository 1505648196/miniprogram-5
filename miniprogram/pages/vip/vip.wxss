/* pages/vip/vip.wxss */
.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* VIP 横幅 */
.hero {
  background: linear-gradient(135deg, #FFE60A 0%, #FFC53D 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.hero-tag {
  align-self: flex-start;
  background: #1A1A1A;
  color: #FFE60A;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A1A;
}
.hero-sub {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.6);
}

/* 会员状态 */
.status {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
}
.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.status-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.status.is-vip .status-name { color: #B8860B; }
.status-line {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
}
.status-expire {
  color: #FF7A45;
  font-weight: 600;
}

/* 权益 */
.benefits {
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
}
.benefit-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}
.benefit-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #666666;
  padding: 8rpx 0;
}
.benefit-dot {
  color: #FFE60A;
  font-weight: 700;
}

/* 套餐 */
.plans {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}
.plan {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  padding: 24rpx 0 20rpx;
  text-align: center;
  position: relative;
}
.plan.active {
  border-color: #FF7A45;
  background: #FFF9F2;
}
.plan-tag {
  position: absolute;
  top: -14rpx;
  right: 12rpx;
}
.plan-name {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 600;
}
.plan-price {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #FF7A45;
  line-height: 1;
}
.plan-yuan {
  font-size: 22rpx;
  font-weight: 600;
}
.plan-tip {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #999999;
}

/* 支付 */
.pay {
  margin-top: 32rpx;
}
.pay .t-button {
  --td-button-primary-bg-color: #1A1A1A;
  --td-button-primary-border-color: #1A1A1A;
  --td-button-primary-color: #FFE60A;
  --td-button-primary-active-bg-color: #333333;
  --td-button-primary-active-border-color: #333333;
}
.pay-note {
  margin-top: 16rpx;
  text-align: center;
  font-size: 20rpx;
  color: #B0B0B0;
}
