/* pages/detail/detail.wxss */
.page {
  min-height: 100vh;
  background: #F6F6F6;
  padding: 16rpx 16rpx 200rpx;
  box-sizing: border-box;
}

.state {
  padding: 160rpx 0;
}

/* 详情加载骨架屏容器：上留白 + 左右留白，贴近真实卡片观感 */
.state-skeleton {
  padding: 24rpx 24rpx 40rpx;
  background: #F6F6F6;
}

/* ============ 顶部信息卡 ============ */
.head {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx 20rpx;
}

.head-type {
  display: inline-block;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 18rpx;
}


.head-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.4;
}

/* ============ 顶部卡片广告（方案 C） ============ */
.detail-ads {
  margin-top: 16rpx;
}

.detail-ad-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.detail-ad-img {
  width: 100%;
  display: block;
}

.detail-ad-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  padding: 20rpx 24rpx;
}

.head-sub {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999999;
}

.head-user {
  color: #666666;
}

.credit-tag {
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
}

/* ============ 封面图 ============ */
.cover {
  width: 100%;
  border-radius: 20rpx;
  margin-top: 16rpx;
  display: block;
}

/* ============ 通用信息卡 ============ */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
}

.card-row {
  display: flex;
  padding: 20rpx 0;
  font-size: 28rpx;
  line-height: 1.5;
  border-bottom: 1rpx solid #F5F5F5;
}
.card-row:last-child {
  border-bottom: none;
}

.card-key {
  flex-shrink: 0;
  width: 160rpx;
  color: #999999;
}

.card-val {
  flex: 1;
  color: #1A1A1A;
  word-break: break-all;
}

.card-val.salary {
  color: #FF7A45;
  font-weight: 700;
  font-size: 32rpx;
}

/* 联系电话栏：脱敏号醒目展示 + 右侧"查看电话"按钮(后续接付费查看完整号) */
.phone-row {
  background: #FFF7E6;
  border-radius: 12rpx;
  margin: 4rpx 0;
  padding-left: 8rpx;
  padding-right: 8rpx;
}
.phone-val {
  color: #FF7A45;
  font-weight: 700;
  font-size: 32rpx;
  letter-spacing: 2rpx;
  /* 占用剩余空间，让"查看电话"按钮自动推最右 */
  flex: 1 1 auto;
}
/* 行内右侧按钮：品牌色小药丸 */
.phone-action {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #1A1A1A;
  background: #FFE60A;
  border-radius: 999rpx;
  border: 2rpx solid #F5D800;
  line-height: 1.2;
  white-space: nowrap;
  /* 按钮轻反馈 */
  transition: all 0.2s ease;
}
.phone-action:active {
  background: #F5D800;
  transform: scale(0.96);
}
/* 加载态：置灰 + 禁用点击，避免支付过程中重复触发 */
.phone-action.is-loading {
  color: #999999;
  background: #F0F0F0;
  border-color: #E0E0E0;
  pointer-events: none;
}

.tags-row {
  align-items: flex-start;
}
.tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* ============ 详情描述 ============ */
.desc-card {
  padding: 8rpx 24rpx 28rpx;
}

.card-section-title {
  font-size: 24rpx;
  color: #999999;
  padding: 20rpx 0 12rpx;
}

.desc-text {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
  user-select: text;
}

/* ============ 底部联系方式栏 ============ */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 悬浮分享按钮（右下角，悬浮在底部操作区上方，图标 + 文字） */
.share-fab {
  position: fixed;
  right: 24rpx;
  bottom: 200rpx;
  width: 104rpx;
  height: 104rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #FF7A45 0%, #FF9E6B 100%);
  border-radius: 50%;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 69, 0.45);
  z-index: 100;
}
.share-fab::after {
  border: none;
}
.share-fab--hover {
  background: linear-gradient(135deg, #F56A35 0%, #FF8A50 100%);
}
.share-fab-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1;
}

/* 悬浮转发按钮（仅管理员可见，位于分享按钮上方，紫蓝渐变区分） */
.wxforward-fab {
  position: fixed;
  right: 24rpx;
  bottom: 320rpx;
  width: 104rpx;
  height: 104rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #5B21B6 0%, #2563EB 100%);
  border-radius: 50%;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(91, 33, 182, 0.45);
  z-index: 100;
}
.wxforward-fab::after {
  border: none;
}
.wxforward-fab--hover {
  background: linear-gradient(135deg, #4C1D95 0%, #1D4ED8 100%);
}
.wxforward-fab-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1;
}

.contact-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  font-size: 20rpx;
  color: #b6b6b6;
  text-align: center;
  margin-bottom: 12rpx;
}
/* 举报入口：低调文字链，与提示同行右侧 */
.report-link {
  color: #999999;
  text-decoration: underline;
  padding: 4rpx 8rpx;
}

.contact-btn {
  --td-button-primary-bg-color: #FFE60A;
  --td-button-primary-border-color: #FFE60A;
  --td-button-primary-color: #1A1A1A;
  --td-button-primary-active-bg-color: #F5D800;
  --td-button-primary-active-border-color: #F5D800;
  --td-button-font-size: 30rpx;
}

/* 底部两个操作按钮：收藏 + 查看联系方式 */
.footer-actions {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}
.fav-btn {
  flex: 0 0 200rpx;
  --td-button-font-size: 30rpx;
}
/* 已收藏态 → 亮金填充 */
.fav-btn.on {
  --td-button-primary-bg-color: #FFE9A8;
  --td-button-primary-border-color: #FFD700;
  --td-button-primary-color: #C58B00;
  --td-button-primary-active-bg-color: #FFDF80;
  --td-button-primary-active-border-color: #FFD700;
  --td-button-primary-active-color: #A97400;
}

/* ---------------- 转发到朋友圈：编辑弹窗 ---------------- */
.fwd-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.fwd-panel {
  width: 100%;
  max-height: 84vh;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}
.fwd-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}
.fwd-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.fwd-tip {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}
/* 发送账号选择 */
.fwd-targets {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.fwd-targets-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.fwd-targets-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.fwd-targets-count {
  font-size: 22rpx;
  font-weight: 600;
  color: #2563EB;
}
.fwd-targets-hint {
  font-size: 22rpx;
  color: #BBBBBB;
  line-height: 1.4;
}
.fwd-targets-tip {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}
.fwd-targets-tip--warn {
  color: #D48806;
}
/* 发送账号多选：横排胶囊卡片 */
.fwd-targets-group {
  width: 100%;
}
.fwd-targets-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
/* 每个账号一个胶囊：选中态用品牌蓝底白字，未选中灰底 */
.fwd-target-chip {
  --td-checkbox-icon-checked-color: #2563EB;
  --td-checkbox-icon-color: #C0C4CC;
  --td-checkbox-icon-size: 32rpx;
  --td-checkbox-title-color: #333333;
}
/* 去掉组件默认边框（borderless），胶囊边框/底色由这里统一控制 */
.fwd-target-chip {
  padding: 12rpx 22rpx;
  background: #F4F5F7;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  transition: all 0.2s ease;
}
/* 选中态：根节点 class 为 t-checkbox--checked（TDesign 源码确认） */
.fwd-target-chip.t-checkbox--checked {
  background: #EEF2FF;
  border-color: #2563EB;
}
.fwd-text {
  width: 100%;
  min-height: 320rpx;
  max-height: 52vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: #F7F7F8;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1A1A1A;
}
.fwd-count {
  align-self: flex-end;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #BBBBBB;
}
.fwd-error {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #FFF1F0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #D4380D;
  line-height: 1.5;
}
.fwd-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.fwd-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.fwd-btn--hover {
  opacity: 0.85;
}
.fwd-btn--cancel {
  background: #F2F2F3;
  color: #666666;
}
.fwd-btn--ok {
  background: linear-gradient(135deg, #5B21B6 0%, #2563EB 100%);
  color: #FFFFFF;
}
.fwd-btn--ok.is-busy {
  opacity: 0.6;
}
/* 按钮内收藏内容（图标+文字横排） */
.fav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.fav-text {
  font-size: 30rpx;
}
.footer-actions .contact-btn {
  flex: 1;
}

/* ============ 本人帖子：编辑 / 删除 按钮 ============ */
.edit-btn {
  flex: 1;
  --td-button-primary-bg-color: #FFE60A;
  --td-button-primary-border-color: #FFE60A;
  --td-button-primary-color: #1A1A1A;
  --td-button-primary-active-bg-color: #F5D800;
  --td-button-primary-active-border-color: #F5D800;
  --td-button-font-size: 30rpx;
}
.del-btn {
  flex: 1;
  --td-button-font-size: 30rpx;
  --td-button-danger-color: #E34D59;
  --td-button-danger-border-color: #E34D59;
  --td-button-danger-active-bg-color: #FBE4E6;
  --td-button-danger-active-border-color: #E34D59;
  --td-button-danger-active-color: #C43A46;
}
