<!-- pages/detail/detail.wxml -->
<!-- 帖子详情页：招聘/求职共用展示结构，语义由 data 区分 -->
<view class="page" wx:if="{{d}}">
  <!-- 顶部信息卡：类型徽章 + 标题 -->
  <view class="head">
    <view class="head-type" style="color:{{d.typeColor}}; background:{{d.typeBg}};">{{d.typeName}}</view>
    <view class="head-title">{{d.title}}</view>
    <!-- 发布人 + 信用 + 时间 -->
    <!-- <view class="head-sub">
      <text wx:if="{{d.username}}" class="head-user">{{d.username}}</text>
      <text wx:if="{{d.creditMeta}}" class="credit-tag" style="color:{{d.creditMeta.color}}; background:{{d.creditMeta.bg}};">{{d.creditMeta.label}}</text>
      <text class="head-time">{{d.agoText}}</text>
    </view> -->
  </view>

  <!-- 顶部卡片广告（方案 C：detailAds 为空时整块不渲染） -->
  <view class="detail-ads" wx:if="{{detailAds.length}}">
    <view
      class="detail-ad-card"
      wx:for="{{detailAds}}" wx:key="id"
      data-item="{{item}}" bindtap="onDetailAdTap"
    >
      <image wx:if="{{item.image}}" class="detail-ad-img" src="{{item.image}}" mode="widthFix" />
      <view wx:if="{{item.title}}" class="detail-ad-title">{{item.title}}</view>
    </view>
  </view>

  <!-- 有图时展示图片 -->
  <image wx:if="{{d.image}}" class="cover" src="{{d.image}}" mode="widthFix" />

  <!-- 关键信息（按 data_type 分支：招工/求职 薪资、转让 转让费、求店 预算、顺风车 行程） -->
  <view class="card">
    <!-- 招工/求职：薪资 + 师傅类型 -->
    <block wx:if="{{!d.isShop && !d.isEquip && !d.isCarpool && !d.isOther}}">
      <view class="card-row">
        <text class="card-key">薪资</text>
        <text class="card-val salary">{{d.salaryText}}</text>
      </view>
      <view wx:if="{{d.salaryNote}}" class="card-row">
        <text class="card-key">薪资说明</text>
        <text class="card-val">{{d.salaryNote}}</text>
      </view>
      <view class="card-row">
        <text class="card-key">师傅类型</text>
        <text class="card-val">{{d.role}}</text>
      </view>
    </block>

    <!-- 二手设备：出售=售价 / 求购=求购预算 + 新旧程度 -->
    <block wx:if="{{d.isEquip}}">
      <view class="card-row">
        <text class="card-key">{{d.equipPriceKeyLabel}}</text>
        <text class="card-val salary">{{d.equipPriceText}}</text>
      </view>
      <view wx:if="{{d.equipCondText}}" class="card-row">
        <text class="card-key">{{d.equipCondKeyLabel}}</text>
        <text class="card-val">{{d.equipCondText}}</text>
      </view>
    </block>

    <!-- 其他：有明示价格才显示"价格"，无则只展示描述/地区 -->
    <block wx:if="{{d.isOther && d.otherPriceText}}">
      <view class="card-row">
        <text class="card-key">价格</text>
        <text class="card-val salary">{{d.otherPriceText}}</text>
      </view>
    </block>

    <!-- 顺风车：出发地 → 目的地 + 时间 + 可乘人数 -->
    <block wx:if="{{d.isCarpool}}">
      <view class="card-row">
        <text class="card-key">出发地</text>
        <text class="card-val">{{d.carFrom}}</text>
      </view>
      <view class="card-row">
        <text class="card-key">目的地</text>
        <text class="card-val">{{d.carTo}}</text>
      </view>
      <view wx:if="{{d.carDepart}}" class="card-row">
        <text class="card-key">出发时间</text>
        <text class="card-val">{{d.carDepart}}</text>
      </view>
      <view wx:if="{{d.carDeadline}}" class="card-row">
        <text class="card-key">最晚出发</text>
        <text class="card-val">{{d.carDeadline}}</text>
      </view>
      <view wx:if="{{d.carSeatsLabel}}" class="card-row">
        <text class="card-key">可乘人数</text>
        <text class="card-val">{{d.carSeatsLabel}}</text>
      </view>
    </block>

    <!-- 店铺转让 transfer：转让费 + 月租/面积/日营业额/带设备 -->
    <block wx:if="{{d.isTransfer}}">
      <view class="card-row">
        <text class="card-key">转让费</text>
        <text class="card-val salary">{{d.shopPriceText}}</text>
      </view>
      <view wx:if="{{d.monthlyRentText}}" class="card-row">
        <text class="card-key">月租</text>
        <text class="card-val">{{d.monthlyRentText}}</text>
      </view>
      <view wx:if="{{d.areaText}}" class="card-row">
        <text class="card-key">面积</text>
        <text class="card-val">{{d.areaText}}</text>
      </view>
      <view wx:if="{{d.dailyRevText}}" class="card-row">
        <text class="card-key">日营业额</text>
        <text class="card-val">{{d.dailyRevText}}</text>
      </view>
      <view wx:if="{{d.equipText}}" class="card-row">
        <text class="card-key">带设备</text>
        <text class="card-val">{{d.equipText}}</text>
      </view>
    </block>

    <!-- 求店 want_shop：预算 + 租金上限/面积下限 -->
    <block wx:if="{{d.isWantShop}}">
      <view class="card-row">
        <text class="card-key">预算</text>
        <text class="card-val salary">{{d.shopPriceText}}</text>
      </view>
      <view wx:if="{{d.rentMaxText}}" class="card-row">
        <text class="card-key">租金上限</text>
        <text class="card-val">{{d.rentMaxText}}</text>
      </view>
      <view wx:if="{{d.areaMinText}}" class="card-row">
        <text class="card-key">面积下限</text>
        <text class="card-val">{{d.areaMinText}}</text>
      </view>
    </block>

    <!-- 店铺类型（转让/求店共用） -->
    <block wx:if="{{d.isShop}}">
      <view class="card-row">
        <text class="card-key">店铺类型</text>
        <text class="card-val">{{d.role}}</text>
      </view>
    </block>

    <!-- 所在地区（顺风车无单一地区，用出发/目的路线展示，故此处隐藏） -->
    <view class="card-row" wx:if="{{!d.isCarpool}}">
      <text class="card-key">所在地区</text>
      <text class="card-val">{{d.regionText}}</text>
    </view>
    <!-- 联系电话：始终只显示脱敏号；右侧按钮会员免费/付费后直接拨打，完整号不渲染到界面 -->
    <view wx:if="{{d.hasPhone}}" class="card-row phone-row">
      <text class="card-key">联系电话</text>
      <text class="card-val phone-val" user-select>{{d.phonesText}}</text>
      <view class="phone-action {{paying ? 'is-loading' : ''}}" bind:tap="onRevealPhone">{{paying ? '加载中…' : (canCall ? '拨打' : (isVip ? '免费拨打' : '查看电话'))}}</view>
    </view>
    <view wx:if="{{d.address}}" class="card-row">
      <text class="card-key">详细地址</text>
      <text class="card-val">{{d.address}}</text>
    </view>
    <!-- 求职专属 -->
    <view wx:if="{{d.isJobseek && d.availability}}" class="card-row">
      <text class="card-key">到岗方式</text>
      <text class="card-val">{{d.availability}}</text>
    </view>
    <view wx:if="{{d.isJobseek && d.serviceArea}}" class="card-row">
      <text class="card-key">可服务地区</text>
      <text class="card-val">{{d.serviceArea}}</text>
    </view>
    <!-- 标签：转让条件 / 求店诉求 / 求职诉求 / 招聘条件 -->
    <view wx:if="{{d.shopConds.length || d.wantShopTerms.length || d.wants.length || d.conds.length}}" class="card-row tags-row">
      <text class="card-key">{{d.isTransfer ? '转让条件' : d.isWantShop ? '求店诉求' : d.isJobseek ? '求职诉求' : '工作条件'}}</text>
      <view class="tags">
        <t-tag wx:for="{{d.isTransfer ? d.shopConds : d.isWantShop ? d.wantShopTerms : d.isJobseek ? d.wants : d.conds}}" wx:key="*this" size="small" variant="light">{{item}}</t-tag>
      </view>
    </view>
  </view>

  <!-- 详情描述 -->
  <view class="card desc-card">
    <view class="card-section-title">详情描述</view>
    <text class="desc-text" user-select>{{d.body}}</text>
  </view>

  <!-- 发布信息 -->
  <view class="card meta-card">
    <view class="card-row">
      <text class="card-key">发布时间</text>
      <text class="card-val">{{d.publishedText}} {{d.agoText}}</text>
    </view>
    <view class="card-row">
      <text class="card-key">浏览量</text>
      <text class="card-val">{{d.views}} 次</text>
    </view>
    <view wx:if="{{d.username}}" class="card-row">
      <text class="card-key">发布用户</text>
      <text class="card-val">{{d.username}}</text>
    </view>
    <view wx:if="{{d.username}}" class="card-row">
      <text class="card-key">信用等级</text>
      <text class="card-val"> <text wx:if="{{d.creditMeta}}"  style="color:{{d.creditMeta.color}}; background:{{d.creditMeta.bg}};">{{d.creditMeta.label}}</text></text>
    </view>
   
  </view>

  <!-- 底部操作区 -->
  <view class="footer-bar">
    <!-- 本人帖子：编辑 / 删除 -->
    <view class="footer-actions" wx:if="{{isMine}}">
      <t-button
        class="edit-btn"
        theme="primary"
        size="large"
        bind:tap="onEdit"
      >编辑</t-button>
      <t-button
        class="del-btn"
        theme="danger"
        variant="outline"
        size="large"
        bind:tap="onDelete"
      >删除</t-button>
    </view>
    <!-- 非本人：收藏 + 查看联系方式 -->
    <block wx:else>
      <view class="contact-hint">
        <text>温馨提示：联系时请核实对方身份</text>
        <!-- 举报入口：进入举报页（?type=report 带帖子 id/类型） -->
        <text class="report-link" bindtap="onReport">举报</text>
      </view>
      <view class="footer-actions">
        <t-button
          class="fav-btn {{isFav ? 'on' : ''}}"
          theme="{{isFav ? 'primary' : 'default'}}"
          variant="{{isFav ? 'dark' : 'outline'}}"
          size="large"
          bind:tap="onToggleFav"
        >
          <view class="fav-content">
            <t-icon name="{{ isFav ? 'heart-filled' : 'heart' }}" size="34rpx" color="{{ isFav ? '#FFD700' : '#999999' }}" />
            <text class="fav-text">{{ isFav ? '已收藏' : '收藏' }}</text>
          </view>
        </t-button>
        <t-button
          class="contact-btn"
          theme="primary"
          size="large"
          loading="{{paying}}"
          bind:tap="onViewContact"
        >{{ isVip ? '免费拨打电话' : '查看联系方式' }}</t-button>
      </view>
    </block>
  </view>

  <!-- 删除确认 -->
  <t-dialog
    visible="{{deleteDialogVisible}}"
    title="删除信息"
    content="删除后不可恢复，确定删除这条信息？"
    confirm-btn="{{ { content: '确定删除', theme: 'danger' } }}"
    cancel-btn="取消"
    bind:confirm="onDeleteConfirm"
    bind:cancel="onDeleteDialogClose"
    bind:close="onDeleteDialogClose"
  />

  <!-- 悬浮分享按钮（右下角，悬浮在底部操作区上方，图标 + 文字） -->
  <button class="share-fab" open-type="share" hover-class="share-fab--hover">
    <t-icon name="share" size="40rpx" color="#FFFFFF" />
    <text class="share-fab-text">分享</text>
  </button>

  <!-- 悬浮转发按钮（仅管理员可见，位于分享按钮上方） -->
  <button
    wx:if="{{isAdmin}}"
    class="wxforward-fab"
    hover-class="wxforward-fab--hover"
    bind:tap="onWxForward"
  >
    <t-icon name="swap-right" size="40rpx" color="#FFFFFF" />
    <text class="wxforward-fab-text">转发</text>
  </button>
</view>

<!-- 加载中：骨架屏（模拟详情布局，避免白屏延迟感） -->
<view class="state-skeleton" wx:elif="{{loading}}">
  <t-skeleton theme="paragraph" animation="gradient" row-col="{{skeletonRows}}" />
</view>
<!-- 空态 / 出错 -->
<t-empty wx:else description="{{loadError || '帖子不存在'}}" class="state" />

<!-- 转发到朋友圈：编辑弹窗（管理员专属）
     点「转发」先预填文案，可以改完再确认；确认后由本机 Worker 发布 -->
<view wx:if="{{forwardDialogVisible}}" class="fwd-mask" catchtouchmove="true">
  <view class="fwd-panel">
    <view class="fwd-head">
      <text class="fwd-title">转发到朋友圈</text>
      <text class="fwd-tip">文案可以直接改，确认后由你电脑上的微信自动发布</text>
    </view>

    <textarea
      class="fwd-text"
      value="{{forwardText}}"
      bindinput="onForwardInput"
      maxlength="1200"
      auto-height
      show-confirm-bar="{{false}}"
      cursor-spacing="24"
      placeholder="朋友圈文案"
    />

    <view class="fwd-count">{{forwardText.length}} / 1200</view>

    <view wx:if="{{forwardError}}" class="fwd-error">{{forwardError}}</view>

    <view class="fwd-btns">
      <view class="fwd-btn fwd-btn--cancel" hover-class="fwd-btn--hover" bindtap="onForwardCancel">
        取消
      </view>
      <view
        class="fwd-btn fwd-btn--ok {{forwarding ? 'is-busy' : ''}}"
        hover-class="fwd-btn--hover"
        bindtap="onForwardConfirm"
      >
        {{forwarding ? '提交中…' : '确认转发'}}
      </view>
    </view>
  </view>
</view>
