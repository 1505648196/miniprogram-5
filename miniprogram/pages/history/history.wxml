<!-- pages/history/history.wxml -->
<!-- 浏览历史：本地缓存 detail_pool 双列卡展示，点卡片进详情 -->
<view class="page">

  <!-- 顶部操作：清空历史 -->
  <view class="toolbar">
    <text class="toolbar-tip">共 {{list.length}} 条浏览记录</text>
    <t-button wx:if="{{list.length}}" theme="default" size="small" variant="text" bind:tap="onClearTap">
      清空历史
    </t-button>
  </view>

  <!-- 空态 -->
  <view class="empty-wrap" wx:if="{{!list.length}}">
    <t-empty icon="time" description="暂无浏览历史" />
  </view>

  <!-- 双列卡 -->
  <view class="goods" wx:else>
    <view class="goods-col">
      <view class="goods-card" wx:for="{{left}}" wx:key="id"
            data-id="{{item.id}}" bindtap="onTap">
        <view class="goods-img" wx:if="{{item.image}}" style="background: {{item.light}};">
          <image class="goods-pic" src="{{item.image}}" mode="widthFix" />
          <view class="goods-type" style="background: {{item.color}};">{{item.typeName}}</view>
        </view>
        <view class="goods-title">{{item.title}}</view>
        <view class="goods-meta">
          <text wx:if="{{!item.image}}" class="goods-meta-type" style="background: {{item.color}};">{{item.typeName}}</text>
          <text>{{item.meta}}</text>
        </view>
        <view class="goods-price">{{item.priceText}}</view>
      </view>
    </view>
    <view class="goods-col">
      <view class="goods-card" wx:for="{{right}}" wx:key="id"
            data-id="{{item.id}}" bindtap="onTap">
        <view class="goods-img" wx:if="{{item.image}}" style="background: {{item.light}};">
          <image class="goods-pic" src="{{item.image}}" mode="widthFix" />
          <view class="goods-type" style="background: {{item.color}};">{{item.typeName}}</view>
        </view>
        <view class="goods-title">{{item.title}}</view>
        <view class="goods-meta">
          <text wx:if="{{!item.image}}" class="goods-meta-type" style="background: {{item.color}};">{{item.typeName}}</text>
          <text>{{item.meta}}</text>
        </view>
        <view class="goods-price">{{item.priceText}}</view>
      </view>
    </view>
  </view>

  <!-- 清空确认 -->
  <t-dialog
    visible="{{clearDialogVisible}}"
    title="清空浏览历史"
    content="确定清空全部浏览记录？"
    confirm-btn="{{ { content: '清空', theme: 'danger' } }}"
    cancel-btn="取消"
    bind:confirm="onClearConfirm"
    bind:cancel="onClearClose"
    bind:close="onClearClose"
  />

</view>
